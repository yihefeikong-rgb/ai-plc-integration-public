FUNCTION_BLOCK "PIDControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
AUTHOR : 'AI_Generated'

VAR_INPUT
    bEnable : Bool;                    // PID 使能
    bReset : Bool;                     // 积分复位
    bManualMode : Bool;                // 手动模式
    rSetpoint : Real;                  // 设定值 (工程单位)
    rProcessValue : Real;              // 过程值 (工程单位)
    rManualValue : Real;               // 手动输出值 (%)
    rKp : Real;                        // 比例增益
    rTi : Real;                        // 积分时间 (秒，0=无积分)
    rTd : Real;                        // 微分时间 (秒，0=无微分)
    rOutputMin : Real;                 // 输出下限 (%)
    rOutputMax : Real;                 // 输出上限 (%)
    rSetpointRampRate : Real;          // 设定值斜坡速率 (单位/秒)
    rDeadband : Real;                  // 死区 (工程单位)
END_VAR

VAR_OUTPUT
    rControlOutput : Real;             // 控制输出 (%)
    rError : Real;                     // 偏差值
    rP : Real;                         // P 分量
    rI : Real;                         // I 分量
    rD : Real;                         // D 分量
    bLimiting : Bool;                  // 输出限幅中
    bAntiWindupActive : Bool;          // 抗饱和激活
    bRampActive : Bool;                // 斜坡进行中
    rSetpointRamped : Real;            // 斜坡后的设定值
END_VAR

VAR
    // PID 内部变量
    rIntegral : Real;                  // 积分累加值
    rPrevError : Real;                 // 上次偏差
    rPrevPV : Real;                    // 上次过程值（用于微分）
    rSampleTime : Real;                // 采样时间 (秒)
    rOutput : Real;                    // 计算输出

    // 设定值斜坡
    rRampTarget : Real;                // 斜坡目标值
    rRampCurrent : Real;               // 斜坡当前值

    // 采样周期
    tCycle : TON;                      // 采样周期定时器
    tRamp : TON;                       // 斜坡更新定时器

    // 限幅中间变量
    bOutHigh : Bool;                   // 输出超上限
    bOutLow : Bool;                    // 输出低于下限
END_VAR

BEGIN
    // ── 采样周期 (200ms) ──
    tCycle(IN := bEnable, PT := T#200MS);

    IF tCycle.Q AND bEnable THEN
        // ── 设定值斜坡 ──
        IF rSetpoint <> rRampTarget THEN
            rRampTarget := rSetpoint;
            rRampCurrent := rRampTarget;  // 简化：一次到位
            bRampActive := FALSE;
        END_IF;

        IF rSetpointRampRate > 0.0 AND rRampCurrent <> rRampTarget THEN
            rRampCurrent := rRampCurrent + rSetpointRampRate * 0.2;
            IF (rSetpointRampRate > 0.0 AND rRampCurrent >= rRampTarget) OR
               (rSetpointRampRate < 0.0 AND rRampCurrent <= rRampTarget) THEN
                rRampCurrent := rRampTarget;
                bRampActive := FALSE;
            ELSE
                bRampActive := TRUE;
            END_IF;
        END_IF;

        rSetpointRamped := rRampCurrent;

        // ── 偏差计算 ──
        rError := rSetpointRamped - rProcessValue;

        // ── 死区处理 ──
        IF ABS(rError) < rDeadband THEN
            rError := 0.0;
        END_IF;

        // ── P 分量 ──
        rP := rKp * rError;

        // ── I 分量（积分分离 + 抗饱和） ──
        bAntiWindupActive := FALSE;
        IF rTi > 0.0 THEN
            // 积分分离：|偏差| > 100 时停止积分
            IF ABS(rError) < 100.0 THEN
                rIntegral := rIntegral + rKp * rError * 0.2 / rTi;
            END_IF;

            // 抗饱和：输出超限时反向积分
            IF rOutput >= rOutputMax OR rOutput <= rOutputMin THEN
                rIntegral := rIntegral - rKp * rError * 0.2 / rTi;
                bAntiWindupActive := TRUE;
            END_IF;
        END_IF;

        rI := rIntegral;

        // ── D 分量（微分先行：对 PV 微分，避免阶跃冲击） ──
        IF rTd > 0.0 THEN
            rD := rKp * rTd * (rPrevPV - rProcessValue) / 0.2;
        ELSE
            rD := 0.0;
        END_IF;

        // ── 合成输出 ──
        rOutput := rP + rI + rD;

        // ── 输出限幅 ──
        bOutHigh := FALSE; bOutLow := FALSE;
        IF rOutput > rOutputMax THEN
            rOutput := rOutputMax;
            bOutHigh := TRUE;
        ELSIF rOutput < rOutputMin THEN
            rOutput := rOutputMin;
            bOutLow := TRUE;
        END_IF;

        bLimiting := bOutHigh OR bOutLow;

        // ── 手动/自动切换（无扰切换） ──
        IF NOT bManualMode THEN
            rControlOutput := rOutput;
        ELSE
            rControlOutput := rManualValue;
        END_IF;

        // ── 更新历史值 ──
        rPrevError := rError;
        rPrevPV := rProcessValue;
    END_IF;

    // ── 复位 ──
    IF bReset THEN
        rIntegral := 0.0;
        rPrevError := 0.0;
        rPrevPV := 0.0;
        rControlOutput := 0.0;
        rRampCurrent := 0.0;
        rRampTarget := 0.0;
    END_IF;

END_FUNCTION_BLOCK
