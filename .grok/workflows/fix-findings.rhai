let meta = #{
    name: "fix-findings",
    description: "按文件派修复子代理，修复子代理流水线审查确认的代码缺陷。每个文件一个 read-write 子代理，输出修改摘要。",
    when_to_use: "审查确认缺陷后的批量修复",
    phases: [
        #{ title: "Fix", detail: "每个文件一个修复子代理" },
    ],
};

let fix_schema = #{
    "type": "object", "required": ["files_changed", "summary"],
    "properties": #{
        "files_changed": #{ "type": "array", "items": #{ "type": "string" } },
        "summary": #{ "type": "string" },
        "notes": #{ "type": "string" },
    },
};

let jobs = [
#{ "file": "mcp-servers/plc-mcp-bridge/_helpers.py", "findings": [ #{ "severity": "CRITICAL", "issue": "plc_apply 执行 preview 变更操作时直接调用 _run_tiaworker，绕过 tools_blocks.py 直接路径的 _audit_gate（begin_control_operation）与 _audit_outcome；生产环境直接路径因空 actor 被 fail-closed 拒绝，唯一可执行的 preview→apply 路径完全无审计记录，破坏 HMAC 审计链完整性", "evidence": "mcp-servers/plc-mcp-bridge/_helpers.py:222-243 plc_apply 直接 tia_result = _run_tiaworker(action, params)，无 begin_control_operation/audit.log；_helpers.py:207-219 _apply_preview 仅校验 token 与结构；grep 确认 plc-mcp-bridge 内 audit 仅存在于 tools_blocks.py（直接路径 L17-33/L97/L102/L105/L148/L154/L156/L189/L194/L197/L23" }, #{ "severity": "LOW", "issue": "_run_python 用 result.update(parsed) 将子进程 stdout JSON 全键并入信封，子进程可覆盖 output/stderr/returncode 等信封字段，破坏调用方对统一信封结构的一致假设", "evidence": "mcp-servers/plc-mcp-bridge/_helpers.py 第 61-66 行构造信封{success,output,stderr,returncode}；第 68-74 行 stdout 可解析为 dict 时执行 result.update(parsed)（第 74 行）全键并入，覆盖信封字段；第 75 行 success 由真实 r.returncode 重算，故 success 不可被直接伪造但 output/stderr/returncode 可被覆盖。调用方：tools_pipeline.py 第 46 行 result.get(\"output\",\"\")[:500" } ] },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "findings": [ #{ "severity": "CRITICAL", "issue": "X/Y 设备号按十进制解析并用 int() 编码进 3 字节设备号字段（如 X10→0x0A、Y20→0x14），但 FX3U/FX5U 的 X/Y 为八进制编号，MC 协议帧须发送八进制数值（X10 应为 0x000008、Y20 应为 0x0010），Q 系列则为十六进制（X10 应为 0x10）。结果：读取访问到错误的输入点，写 Y20 实际驱动 Y24，人工确认的地址与真实控制目标不一致，且 X8/X9 这类非法八进制地址被静默别名到其他设备，全程无任何报错。", "evidence": "mc_protocol.py:63-67 十进制 int(m.group(2)) 解析；mc_protocol.py:127/:147 struct.pack(\"<I\", offset)[:3] 直接入帧，X10→0x0A、Y20→0x14；test_mc_protocol.py:71-78 断言 X10→10、Y20→20；模块内 grep 八进制/十六进制/进制转换零匹配；mc_protocol.py:3 与 README.md:3,13 声明支持 FX3U/FX5U/Q/iQ-R 而 mcp_common/config.py:181-182 无系列配置；server.py:264/312" } ] },
#{ "file": "mcp-servers/tia-mcp/server.py", "findings": [ #{ "severity": "HIGH", "issue": "_safety_gate 只检查 result.allowed 不检查 needs_confirmation；download_to_plcsim（含 UI Automation 自动模拟点击 fallback）、import_scl_file、compile_project 等危险工程操作无一次性人工确认令牌，且 _eng.* 标签不命中 write_rules，require_bits 互锁不适用", "evidence": "server.py L1244-1255: io_map_scl=generate_io_map(json_path); scl_path=scl_dir/IO_Map_*.scl; open(scl_path,'w').write(io_map_scl) — 无 TIA 导入调用。server.py L1258-1265: call_result=insert_fb_calls([io_map_name]); steps.append(result:'success' if call_result==0 else f'code={call_result}') — 非0不失败。server.p" }, #{ "severity": "HIGH", "issue": "full_pipeline 中 IO_Map SCL 只写盘未导入 TIA，且 insert_fb_calls 返回非 0 时仍以 ok=True 返回并审计记录 result=ok；全新运行时 OB1 调用链实际未建成却报告成功（fail-open）", "evidence": "server.py L1035-1049：plc_sw.BlockGroup.Blocks.Import(FileInfo(xml_path), ImportOptions.Override, SWImportOptions(2)) → compiler.Compile() → project.Save()（L1039）→ 然后才检查 state != \"Success\" / ErrorCount > 0 并 return ok=False（L1043-1049）；tia_session.py L262-281 finally 中 L265 无条件 project.Save()；server." } ] },
#{ "file": "mcp-servers/modbus-mcp/server.py", "findings": [ #{ "severity": "HIGH", "issue": "熔断计数失效：_record_write_error() 累加的设备级写失败会在下一次写入的 safety_validator.validate() 通过检查时被清零（safety/validator.py 第318行 self.consecutive_errors=0），连续设备/网络写失败永远无法累积到 _MAX_ERRORS 触发熔断，modbus_reset_fuse 宣称的'连续写入失败自动熔断'对设备故障无效", "evidence": "safety/validator.py:318 'self.consecutive_errors = 0'（通过所有检查后清零，与发现引用的行号一致）；safety/validator.py:277 'if self.consecutive_errors >= _MAX_ERRORS: return ValidationResult(False, f\"熔断: 连续...\")'；safety/validator.py:17 '_MAX_ERRORS = int(_cfg.get(\"safety_max_consecutive_errors\", \"3\"))'。mcp-servers/modbus-" }, #{ "severity": "MEDIUM", "issue": "共享 _client 生命周期竞态：get_client() 在锁内返回缓存客户端后，读写经 asyncio.to_thread 在锁外使用；任一并发工具调用的异常路径执行 _reset_client() 会关闭该全局连接，导致另一个正在执行的调用虚假失败（锁不保护返回后客户端存活）", "evidence": "server.py:42-43 全局 _client/_client_lock；158 行在锁内 return _client；187-188/216-217/243-244/325/415/455 行经 asyncio.to_thread 锁外使用同一客户端（写路径 330-331、420-421 行还跨 await 读回）；161-170 行 _reset_client() 锁内 close() 并置 None；异常路径调用点 199/226/256/346/436/467；scan_devices（447-473 行）循环内对 10 个 slave_id 复用同一客户端，离线从站在 _M" }, #{ "severity": "MEDIUM", "issue": "scan_devices 对每个离线 slave 超时后都执行 _reset_client() 关闭共享连接，下一轮迭代再 get_client() 重连，10 个离线 slave 最坏约 30s+ 串行耗时，且反复关闭共享连接放大并发竞态", "evidence": "server.py:453 循环 range(1,11)；line 455 每轮 asyncio.to_thread(get_client)；line 466-468 except Exception 内 _reset_client()；line 33-34 _MODBUS_TIMEOUT=3.0/_MODBUS_RETRIES=0；line 135-172 get_client()/_reset_client() 共享 _client 与 _client_lock。已装 pymodbus 源码：client/tcp.py recv() 用 select 阻塞至 timeout_connect" }, #{ "severity": "LOW", "issue": "读参数边界校验缺失：_validate_read_params 只校验 address<=0xFFFF 与 count<=max，未校验 address+count-1<=0xFFFF；read_register(65534,125)/read_coil(65535,2000) 会生成超出 16 位地址空间的请求帧而非本地拒绝", "evidence": "server.py:100-107 _validate_read_params 仅检查 0<=address<=_MODBUS_MAX_ADDRESS 与 1<=count<=max_count，无 address+count-1 上界判断；server.py:35 _MODBUS_MAX_ADDRESS=0xFFFF、36 _MODBUS_MAX_READ_REGISTERS=125、37 _MODBUS_MAX_READ_BITS=2000；server.py:212+215 read_register 校验通过后直接调 read_holding_registers(address,cou" }, #{ "severity": "LOW", "issue": "确认令牌在影子仿真检查之前被消费：write_coil/write_register 先 consume() 后 shadow_sim.simulate_write()，若仿真因跳变/禁止标签拒绝写入，一次性人工确认令牌已被烧掉需重新签发", "evidence": "mcp-servers/modbus-mcp/server.py 第300-308行(consume)→第313行(simulate_write)→第314-318行(shadow_rejected 拒绝)；write_register 第390-398行→第403行→第404-408行。safety/confirmation.py consume() 第150-158行：INSERT nonce 到 used_confirmation_tokens，IntegrityError→'确认令牌已使用'（单次消费）。safety/shadow_simulator.py 第144-186行：forb" }, #{ "severity": "HIGH", "issue": "modbus_reset_fuse 中 audit.log(\"fuse_reset\",...)（第510行）与 fuse_reset_blocked 分支（第505行）是全文件唯一未包 try/except 的审计调用：fuse 已被 reset_fuse() 实际重置后，若审计写入抛 AuditStorageError/AuditConfigurationError（消息含审计文件路径），异常原样抛给 MCP 客户端，熔断重置这一安全动作无审计记录，且客户端重试会因确认令牌已消费而再次失败——未处理失败路径且泄露内部路径信息", "evidence": "server.py:508-509 `safety_validator.reset_fuse()` 后紧跟无保护的 `audit.log(\"fuse_reset\",...)`；server.py:504-506 ConfirmationError 分支的 audit.log 无 try/except。validator.py:65-69 reset_fuse() 仅重置计数器，不写审计，副作用先于审计发生。audit.py:339 `raise AuditStorageError(f\"审计存储不可写: {e}\")`、audit.py:271/280 消息含 self.path、audit.py" }, #{ "severity": "MEDIUM", "issue": "scan_devices 中 online/offline 分支的 audit.log 位于 per-slave try 块内：审计记录失败会被误判为从站通信异常，把健康从站标记为 error 并触发 _reset_client() 断开共享连接；内层 except 里的 audit.log 又被裸 except Exception: pass 吞掉——审计异常与设备异常的失败路径被混淆", "evidence": "D:\\claude code xiangmu\\AI 接入PLC\\mcp-servers\\modbus-mcp\\server.py L453-473：scan_devices 中 audit.log(\"scan\",...,\"online\"/\"offline\") 均在 per-slave try 内；except Exception as exc 分支调用 _reset_client()（L469）并将该从站标记 error（L472），内层 try audit.log(...)/except Exception: pass（L470-471）吞掉审计异常。D:\\claude code xiang" }, #{ "severity": "MEDIUM", "issue": "read_coil/read_register/read_discrete_input 三个工具的异常分支中 audit.log 失败被裸 except Exception: pass 吞掉（第197-199/229-231/259-261行），读取失败在审计存储不可用时完全无记录、无告警、不计数熔断，与写路径（审计失败计入熔断并显式返回错误）行为不一致，形成审计链缺口", "evidence": "server.py 第201-204行(read_coil): `try: audit.log(\"read\", f\"coil.{address}\", \"\", success=False, detail=str(e)) / except Exception: pass`；第229-232行(read_register)与第262-265行(read_discrete_input)同构。写路径对比：第336-342行 `except Exception: _record_write_error(); return {... \"status\":\"error\", \"error\":\"写入已执行但审计记录" } ] },
#{ "file": "edge-gateway/src/app.py", "findings": [ #{ "severity": "LOW", "issue": "_safe_write 中 resolve_s7_write_address 调用未捕获 InterlockConfigError，互锁规则加载失败时拒绝写入但绕过 _audit_reject 审计路径，审计链产生无痕盲区", "evidence": "edge-gateway/src/app.py:198 裸调用 safety_validator.resolve_s7_write_address(target)（前后无 try/except）；safety/validator.py:40 class InterlockConfigError(RuntimeError)，129-137 当 self._interlock_loaded 为 False 时 raise InterlockConfigError，docstring 注明'便于调用方与审计记录配置加载失败'；validator.py:75-78 规则文件缺失、116-118 解析失" }, #{ "severity": "MEDIUM", "issue": "AI 熔断计数失效：decide_control 已将非法输出转为合法 alert JSON，ai_control_loop 中 json.loads 恒成功并把 _ai_json_fail_count 重置为 0，except json.JSONDecodeError 分支不可达，『连续3次非JSON响应熔断』永不触发；且 decide_control 抛出的 API 异常不递增计数，与 analyze_data 异常计数逻辑不一致", "evidence": "edge-gateway/src/ai_client.py:217-222（parse_decision 失败→返回 json.dumps alert JSON）；edge-gateway/src/ai_client.py:88-105（parse_decision 先 json.loads，失败统一返 None）；edge-gateway/src/app.py:152-155（json.loads 后无条件 _ai_json_fail_count=0）；edge-gateway/src/app.py:159-168（except JSONDecodeError 不可达，except Exce" }, #{ "severity": "MEDIUM", "issue": "_read_safety_bit 用 S7Adapter.read_address 读取 interlock-rules.yml 的符号位地址(DB1.SafetyOK/DB1.EmergencyStopOff)，而 S7Adapter 仅支持数字地址格式，位读取恒抛异常返回 None，require_bits 互锁恒失败使 AI 写路径在当前配置下永远无法成功；每次失败尝试还使全局 validator.consecutive_errors+1，连续3次后写通道被全局熔断锁死", "evidence": "edge-gateway/src/app.py:378-387 定义并注册 _read_safety_bit(address) 且内部 s7.read_address(address)+except Exception→None；s7_adapter.py:295-300 对 DB1.X 拆出 inner=SAFETYOK，L305-325 返回 (UNKNOWN,0,0,0)，L414 raise ValueError；safety/interlock-rules.yml L15-20 对 DB1.MOTOR_RUN/DB1.MotorSpeed 的 require_bits 含 DB1.S" }, #{ "severity": "LOW", "issue": "_write_influx 中 float(d[\"value\"]) 在 try/except 之外，任一标签值不可转 float 时异常经 asyncio.to_thread 冒泡到 run() 外层 except，导致当轮 ai_control_loop 被跳过并触发退避；遥测格式错误不应中断整个采集控制周期", "evidence": "edge-gateway/src/app.py:112 `.field(\"value\", float(d[\"value\"]))` 位于 for 循环(105-114行)内、try/except(117-121行,仅包 write)之外；app.py:289 `await asyncio.to_thread(self._write_influx, data)` 在 while 循环 try(286行)内；app.py:294 `except Exception as e:` → consecutive_failures+=1；app.py:298-299 backoff=min(consecut" }, #{ "severity": "LOW", "issue": "settings.get(\"s7_rack\",\"0\")/s7_slot 恒返回默认值：env_config() 的 default_env 不含 S7_RACK/S7_SLOT，os.getenv 从不查询，Config.__getattr__ 对缺失键抛 AttributeError 后回退默认，rack/slot 配置实际无效", "evidence": "edge-gateway/src/app.py:24 settings = env_config()；app.py:371-372 rack=int(settings.get(\"s7_rack\",\"0\"))、slot=int(settings.get(\"s7_slot\",\"1\"))。mcp_common/config.py:171-190 default_env 无 S7_RACK/S7_SLOT；config.py:192-193 for key,default in default_env.items(): data[key.lower()]=os.getenv(key,default)；" }, #{ "severity": "HIGH", "issue": "写入路径仍用裸 json.loads(raw_response) 而非文档要求的 parse_decision，且 decide_control 调用 parse_decision 时未传 current_values，导致 _exceeds_max_delta 的 50% 值变化保护（代码标注为强制）从未在实际写入路径生效", "evidence": "app.py:153-154 'raw_response = await ai.decide_control(analysis, available); decision = json.loads(raw_response)'；ai_client.py:95-96 docstring '调用方（如 app.py）应以此替代裸 json.loads'；ai_client.py:217 'parse_decision(raw, available_tags)' 未传 current_values；ai_client.py:138-143 'if action == \"write\" and curr" }, #{ "severity": "MEDIUM", "issue": "AI 决策熔断器失效：decide_control 将无效输出转为合法 alert JSON 使 JSONDecodeError 分支不可达，第 168-169 行通用异常分支不递增 _ai_json_fail_count，持续 AI 失败（无效输出或硬错误）永不触发 _ai_fused 且无审计记录", "evidence": "app.py:153-169 (try/JSONDecodeError死代码/通用except不计数); app.py:155 (_ai_json_fail_count=0 在每次无效输出后重置); ai_client.py:194-224 (decide_control 无效输出转硬编码alert JSON, 218行 if parse_decision(...) is None → json.dumps alert); ai_client.py:89-149 (parse_decision 用 json.loads 校验, 102行); ai_client.py:160-167 (deci" } ] },
#{ "file": "mcp-servers/plc-mcp-bridge/tools_pipeline.py", "findings": [ #{ "severity": "HIGH", "issue": "run_pipeline 与 golden_restore 在子进程退出码非零但 stdout 非空时丢弃 success=False 并直接返回原始输出（p3_flow 失败分支仍向 stdout 打印），调用方无法识别下载/流水线失败，失败被掩盖", "evidence": "mcp-servers/plc-mcp-bridge/tools_pipeline.py L132-135: `if result.get(\"success\") is False and not out: return _format_result(False, ...)` 后紧跟 `return f\"流水线结果:\\n{out[:1000]}\" if out else \"✅ 流水线完成\"`，out 非空时 success=False 被丢弃；L150-151: `out = result.get(\"output\", \"\"); return out if out else _format_res" }, #{ "severity": "LOW", "issue": "download_project 的 compile_first 仅在 method==auto 时生效，其他方法被静默忽略；且 dry_run 提前返回在 method 合法性校验之前，dry_run=True 配合非法 method 返回预览而非错误", "evidence": "tools_pipeline.py:36-37 `if compile_first and method == \"auto\": extra_args = [\"--compile-first\"]`，method_map 其余分支不携带编译参数；download_to_plcsim.py:695/699/706 `download_via_ui(compile_first)`、`_try_download_via_tiaworker(compile_first, target_ip)`、`_try_download_via_python(compile_first, target_ip)` 证明底" } ] },
#{ "file": "mcp-servers/plc-gateway/providers/tiacommander.py", "findings": [ #{ "severity": "HIGH", "issue": "apply_patch 中 net_idx = op.get(\"network_index\", 0) 使缺失 network_index 的操作静默回退到网络 0，且默认值 0 必然通过 `isinstance(net_idx, int) and net_idx < 0` 校验，导致\"network_index 必须是非负整数\"的 fail-closed 检查失效；与 network_patch._validate_operation 对缺失索引显式报错的行为不一致，缺失字段的操作会修改网络 0 而非被拒绝", "evidence": "tiacommander.py:498 `net_idx = op.get(\"network_index\", 0)`; tiacommander.py:505 `if not isinstance(net_idx, int) or net_idx < 0:` (0 恒通过); tiacommander.py:448-455 docstring 宣称'Provider 层独立 fail-closed：…拒绝…无效 network_index'; network_patch.py:152-154 缺失时 `net_idx is None` 报'缺少必填字段 network_index'; cont" } ] },
#{ "file": "mcp-servers/opcua-mcp/server.py", "findings": [ #{ "severity": "MEDIUM", "issue": "write_node 中 3 处保护性拒绝（类型转换失败 L451、互锁拦截 L482、范围拦截 L489）调用 safety.record_write 均未传 count_fuse=False，违反 opcua_safety.py 文档声明的'互锁/范围等保护性拒绝不应触发熔断'契约；安全位未置位时连续 3 次写入尝试即误触发熔断，锁死全部写入直到人工确认重置", "evidence": "opcua_safety.py:212-214 count_fuse docstring 明确'互锁/范围等正常保护性拒绝不应触发熔断，调用方应传 False'；opcua_safety.py:231-236 record_write 对 not success and count_fuse 累加 consecutive_errors，达到 max_errors=3（L73）触发 trip_fuse（L242-258）；server.py:451 safety.record_write(node_id, value, False, str(exc))、L481 safety.record_wr" }, #{ "severity": "MEDIUM", "issue": "_require_bits_for 按大小写精确匹配 rule.target，而 validator 按 .upper() 大小写不敏感匹配；大小写变体标签写入时安全位异步预取被跳过，_BIT_CACHE 中的陈旧位值（仅断开时清空）可直接放行 require_bits 检查——对 check_interlock 不复查的位（TemperatureSensorOK/PumpPressureOK/PressGuardClosed 等）构成陈旧数据绕过的互锁旁路路径，反之则无谓拒绝写入", "evidence": "server.py:151 `if rule.get(\"target\") == tag_name:`（精确匹配）；validator.py:92 `_rules_by_target.setdefault(target.upper(), ...)`、validator.py:153 `tag_key = str(tag_name).upper()`、validator.py:158 `for rule in self._rules_by_target.get(tag_key, ()):`（大小写不敏感）；server.py:457-459 `required_bits = _require_bi" }, #{ "severity": "MEDIUM", "issue": "connect() 的失效连接清理重连路径（L257-266）只置 _client=None 重建连接，未像 disconnect()（L305-308）那样清空 _BIT_CACHE/_VTYPE_CACHE；重连后 auto 写入复用上一会话缓存的 VariantType 与安全位值，PLC 工程变化后类型/位状态可能陈旧错误", "evidence": "server.py L259-266 重连路径仅 disconnect()+_client=None+_endpoint=\"\"，无缓存清理；L305-308 disconnect() 含 _BIT_CACHE.clear();_VTYPE_CACHE.clear()；L202-207 _vtype_for() 缓存命中即返回 _VTYPE_CACHE[node_id]；L518-520 auto 写入经 _vtype_for 构造 ua.Variant；L458-459 每次写入前 _refresh_safety_bits() 覆盖位缓存，validator.py L227-248 _pref" }, #{ "severity": "MEDIUM", "issue": "_conn_lock 仅保护 connect/disconnect，write_node/read_node/browse/get_status/_refresh_safety_bits/_browse_recursive 均无锁访问全局 _client/_endpoint，与并发 disconnect 存在 TOCTOU 竞态；连接被置空引发的异常被计入真实写入失败，可导致无谓熔断", "evidence": "server.py:98 (_conn_lock = asyncio.Lock()) 全文件仅 :256/:295 两处 async with；server.py:444 `if _client is None:` → :479 `await safety.check_interlock(_client)` → :518 `node = _client.get_node(node_id)`，其间 :462/:475/:520/:525 均为 await 交错点；server.py:305 `_client = None`；server.py:531-533 `except Exception " }, #{ "severity": "LOW", "issue": "check_value_range 用原始 node_id 完整字符串匹配 VALUE_LIMITS（键为 ns=3;s=...）；同一标签以裸名（DB1.Pressure）或其他 ns 索引传入时范围检查静默跳过，且该标签无 validator 规则兜底，数值上限失效", "evidence": "opcua_safety.py:61-66 VALUE_LIMITS 键为 'ns=3;s=DB1.MotorSpeed/HeaterPower/ConveyorSpeed/Pressure'；opcua_safety.py:175/186-188 check_value_range 以 node_id not in VALUE_LIMITS 返回 'OK（无范围限制）'；server.py:487 range_ok, range_reason = safety.check_value_range(node_id, converted) 传原始串；server.py:123-135 _node" }, #{ "severity": "LOW", "issue": "reset_fuse 先消费一次性确认令牌（L561）再调用 safety.reset_fuse()（L573）；熔断器未触发时返回'无需重置'但令牌已被作废，无谓消耗且未先核实熔断状态", "evidence": "server.py L559-570: confirmation_service.consume(confirmation_token, operator=actor, target='opcua.fuse_reset', value='reset', device_id=_confirmation_device_id()) 在 L571 result = safety.reset_fuse() 之前执行；opcua_safety.py L270-271: 'if not FUSE_STATE[\"tripped\"]: return \"熔断器未触发，无需重置\"'；confirmation.py " }, #{ "severity": "LOW", "issue": "connect() 第 248 行 endpoint = endpoint or approved_opcua_endpoint() 未捕获 get_control_target() 抛出的 TargetConfigurationError，控制目标配置缺失时原始异常直接逃逸出工具，绕过 require_opcua_endpoint 的友好拒绝路径", "evidence": "server.py:248 endpoint = endpoint or approved_opcua_endpoint()（try 从 249 行开始，仅包裹 250 行 require_opcua_endpoint，251-252 行捕获 TargetConfigurationError 返回 '🚫 连接被拒绝'）；control_target.py:38-40 approved_opcua_endpoint() 直接 return f\"opc.tcp://{get_control_target().plc_ip}:{OPCUA_PORT}\"；control_target.py:20-22" }, #{ "severity": "HIGH", "issue": "write_node 的安全阻断路径（write_blocked/interlock_blocked/range_blocked）与 disconnect 失败路径中的 _audit.log()/_audit.begin_control_operation() 调用均未包裹异常处理；mcp_common/audit.py 在链尾损坏、审计文件不可写或生产环境缺持久密钥时会抛 AuditStorageError/AuditConfigurationError（消息含绝对日志路径与 OS 错误文本），该裸异常会经 FastMCP 原样回传客户端，绕过模块自有的 _safe_error 脱敏；且 begin_control_operation 位于 try 内，其 except 处理器再次调用 _audit.log 会二次抛错掩盖原始异常", "evidence": "mcp-servers/opcua-mcp/server.py:303 (_audit.log('disconnect_failed',...)位于except内未包裹，且若抛错会跳过第305-308行状态清理)；server.py:452,462,467,474,482,490,507 (write_node各阻断路径裸调_audit.log)；server.py:513 (begin_control_operation在try内)+server.py:533 (except处理器再次调_audit.log→双抛)；mcp_common/audit.py:189-194,265-280,33" } ] },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "findings": [ #{ "severity": "LOW", "issue": "_melsec_write_guard 对字设备只允许 0~0xFFFF，而 mc_protocol.build_write_request 允许 -32768~-1 并按补码编码（test_build_write_negative 固化了 -1→0xFFFF 路径）。服务端永远拦下负值，协议层支持的死代码路径与守卫契约不一致，导致 write_device('D100', -1) 返回 blocked 而协议测试却验证负值可编码。", "evidence": "server.py:230-233 'if not (0 <= value <= 0xFFFF): return False, ...'; mc_protocol.py:157-160 'not (-0x8000 <= value <= 0xFFFF): raise ...; body += struct.pack(\"<H\", value & 0xFFFF)'; test_mc_protocol.py:351-355 'build_write_request(\"D100\", -1)... assert value == 0xFFFF'; server.py:352-358 守卫拦截后返回 {\"" }, #{ "severity": "HIGH", "issue": "write_device 第 5 步 try 块未捕获 _audit_control_intent/_audit_confirmed/_audit_log 抛出的 AuditStorageError/AuditConfigurationError(RuntimeError 子类)，审计存储不可写或生产环境缺 AUDIT_HMAC_KEY 时异常原样穿透到 MCP 客户端，消息包含内部审计日志绝对路径；modbus-mcp/server.py 用宽 except 返回干净 error 状态且 tests/test_audit_fail_closed.py 已固化该契约，本模块未遵循", "evidence": "mitsubishi-mcp/server.py:399-417 第5步try内第一句 await _audit_control_intent(...) 后仅 except MCFrameError(57行mc_protocol.py class MCFrameError(Exception)) 与 (TimeoutError,IncompleteReadError,OSError,ConnectionError,struct.error)；mcp_common/audit.py:74/78 class AuditConfigurationError(RuntimeError)/class A" }, #{ "severity": "MEDIUM", "issue": "所有 _audit_log 调用无 try/except 防护：成功路径上 audit.log 抛异常会把已成功的 PLC 读/写转成工具错误，except 块内抛审计异常会掩盖原始错误；生产环境(AI_PLC_ENV/APP_ENV=production)下 audit.log 对默认操作者 ai-agent 抛 AuditConfigurationError，导致每次读都失败在审计步", "evidence": "server.py:248-251 _register_write_error 在 _lock 内 consecutive_errors += 1；server.py:409/414 两处写失败分支调用它；server.py:359 写入前先调用 safety_validator.validate(addr, value)；validator.py:318 通过路径无条件 self.consecutive_errors = 0；validator.py:277-278 熔断检查 if consecutive_errors >= _MAX_ERRORS（先于清零）；validator.py:17" }, #{ "severity": "MEDIUM", "issue": "_read_frame 仅拒绝 data_len<2，对 peer 声称的 DataLen(最大 0xFFFF)无合理上限，_read_exact 在持全局 _io_lock 期间按该长度等待；缓慢滴灌的异常响应可长时间独占互斥锁，卡住全部并发读写请求", "evidence": "server.py:133-138 `_read_frame` 中 `data_len = struct.unpack(\"<H\", header[7:9])[0]`，仅 `if data_len < 2: raise MCFrameError`，随后 `body = await _read_exact(reader, data_len)`；server.py:151-155 `async with _io_lock: ... return await _read_frame(r)`；server.py:116-124 `_read_exact` 循环 `chunk = await asynci" } ] },
#{ "file": "mcp-servers/desktop-mcp/server.py", "findings": [ #{ "severity": "HIGH", "issue": "tool_hotkey 仅检查多键 HOTKEY_BLACKLIST，单键调用 hotkey(keys=[\"delete\"])/[\"f2\"] 绕过 PRESS_KEY_BLACKLIST，pyautogui.hotkey 实际执行危险按键（如 Delete 删文件），直接击穿 press_key 的数据丢失防护", "evidence": "mcp-servers/desktop-mcp/server.py 行46-63 HOTKEY_BLACKLIST 全为多键组合；行84-94 _is_blacklisted_hotkey 仅对 HOTKEY_BLACKLIST 做子集匹配，{delete}/{f2} 均不命中；行395-403 tool_hotkey 行400查 _is_blacklisted_hotkey、行402 直接 pyautogui.hotkey(*keys)；行97-100 PRESS_KEY_BLACKLIST={'delete','del','f2'}；行103-107 _is_blacklisted_pre" }, #{ "severity": "MEDIUM", "issue": "_require_auth 中 hmac.compare_digest 对含非 ASCII 的 str 抛 TypeError，且该调用位于 handle_tool_call 的 try/except 之外，未捕获异常沿 main()/asyncio.run 传播导致整个进程崩溃；客户端发一个非 ASCII auth_token 即可打挂服务器（DoS），环境变量 token 本身非 ASCII 时每次调用都崩", "evidence": "mcp-servers/desktop-mcp/server.py:24 _AUTH_TOKEN=os.environ.get(\"MCP_AUTH_TOKEN\",\"\")；server.py:37 token=args.get(\"auth_token\",\"\")；server.py:38 仅 isinstance(str) 检查；server.py:39 hmac.compare_digest(token,_AUTH_TOKEN)；server.py:224 auth_err=_require_auth(args) 在 try:(243 行) 之前；server.py:712 await hand" }, #{ "severity": "MEDIUM", "issue": "tool_click 只传 x 或 y 之一时静默在当前位置点击并返回 {\"success\":true,\"x\":传入值,\"y\":null} 谎报成功，与实际动作不一致，可能造成误点击；同模块 double_click/right_click/scroll 均对 x/y 不配对显式抛 ValueError，此处缺失", "evidence": "mcp-servers/desktop-mcp/server.py 第 337-347 行：`if x is None or y is None: pyautogui.click(button=button, clicks=clicks, interval=interval) ... return {\"success\": True, \"x\": x, \"y\": y, \"button\": button}`；第 355 行 `if (x is None) != (y is None): raise ValueError(\"参数 x 和 y 必须同时提供或同时省略\")`（同型检查亦在第 368、412" }, #{ "severity": "LOW", "issue": "tool_click 未校验 clicks>=1（0 或负值不产生点击却返回 success）且 interval 可为负（触发 time.sleep 异常变成笼统执行失败），与 press_key 对 presses>=1 的校验不一致", "evidence": "server.py L143-155：_to_float 对 float('nan')/float('inf')/float('NaN') 均不抛异常；L192：data = json.loads(line) 使用默认 parse_constant，接受 NaN/Infinity；调用链 L339→L343-344 pyautogui.click(interval=)、L380→L382 pyautogui.moveTo(duration=)、L390→L392 pyautogui.write(interval=)、L426→L429 pyautogui.dragTo(duration=)；L" }, #{ "severity": "LOW", "issue": "tool_hotkey/tool_press_key 的黑名单拒绝以 {\"error\":...} 放进成功 result 而非 JSON-RPC error 返回，与认证(-2)/确认门(-3) 的失败语义不一致，客户端按 success 处理时会误判动作已执行", "evidence": "server.py:400 return {\"error\": f\"按键组合 {keys} 在黑名单中，禁止执行（危险操作）\"}；server.py:488 return {\"error\": f\"按键 '{key}' 在危险黑名单中，禁止执行（可能导致数据丢失）\"}；server.py:276-281 所有 result 均以 \"result\": {\"content\":[{\"type\":\"text\",\"text\":json.dumps(result,...)}]} 成功响应发出；server.py:230 \"error\": {\"code\": -2, \"message\": auth_err}；se" }, #{ "severity": "LOW", "issue": "mcp_recv 用 {\"_parse_error\":true} 哨兵值表示解析失败，主循环 req.get(\"_parse_error\") 判断与合法请求顶层键冲突，客户端请求若含该键会被误判并以 id=None 应答，破坏请求/响应关联", "evidence": "mcp-servers/desktop-mcp/server.py 第 196 行 `return {\"_parse_error\": True}`（json.JSONDecodeError/ValueError 分支）、第 198 行（非 dict 分支）；第 691 行 `if req.get(\"_parse_error\"):` 位于主循环 `while True` 内、方法分发（tools/list、tools/call）之前；第 693-699 行回送 `{\"jsonrpc\":\"2.0\",\"id\":None,\"error\":{\"code\":-32700,\"message\":\"Parse " }, #{ "severity": "LOW", "issue": "tool_* 均为 async def，asyncio.to_thread(tool_*, args) 在线程中只创建协程对象即返回，阻塞的 pyautogui 调用实际在事件循环线程执行，声明的非阻塞卸载（注释\"运行中不要动鼠标\"等设计意图）未生效", "evidence": "独立读取 mcp-servers/desktop-mcp/server.py：①247-273 行所有分发均为 await asyncio.to_thread(tool_*, args)；②302/331/350/363/375/385/394/405/420/432/468/473/480 行共 13 个 tool_* 均为 async def；③283 行 json.dumps(result, ensure_ascii=False) 对协程对象序列化必抛 TypeError，289 行 except Exception 捕获后回送通用错误，全文件无任何 await tool_* 协程的路径" } ] },
#{ "file": "mcp-servers/robot-mcp/server.py", "findings": [ #{ "severity": "HIGH", "issue": "snap7 输出字节缓存仅首次写入时加载且不再刷新（355-374行）：PLC 在急停时每周期强制清零 Q0.0-Q0.4、正常模式每周期驱动 Q0.5/Q0.7（见 pnp_fc.scl）。急停期间允许的 False 写回（如 _safe_go_home）会把缓存中的陈旧 True 位写回，瞬时重新置位执行器；执行器写入也会用陈旧灯位覆盖 PLC 驱动的指示灯。", "evidence": "server.py:362 `if self._snap_out_cache.get(info[byte]) is None or info[bit] >= 5:` 仅首次或灯位(bit>=5)写入时执行 read_area(0x82,...) 重读；server.py:370-375 执行器位写入复用陈旧缓存 data 并整字节 write_area 写回；server.py:329 急停门禁仅拦截 value=True；server.py:569-585 _safe_go_home 全写 False 且不触发灯位重读；pnp_fc.scl:14-22 急停分支每周期 Q0_0..Q0_4:" }, #{ "severity": "MEDIUM", "issue": "模拟后端急停恢复死锁：_estop_reset_required 置位后 write_io(\"sensor_estop\",True) 被拦截（337-345行），而 confirm_estop_recovery 又要求 sensor_estop 已为 True（393-399行），两条件互斥，急停+一次执行器写入被拒后模拟后端无法通过公开 API 恢复。", "evidence": "mcp-servers/robot-mcp/server.py:200-202：`if name == 'grab' and value:` + `# 夹爪闭合时，模拟检测到物料（前提是有物料在附近）` + `self._sim_state['sensor_item_detected'] = True`，无任何物料邻近检查。server.py:344-345：模拟分支 `self._sim_state[name] = value; self._update_sim_dependencies(name, value)`。server.py:687：pick 仅检查入口 `sensor_entry" }, #{ "severity": "MEDIUM", "issue": "control_conveyor(981-988)、go_home(643-657)、move_arm_to 的 home 分支(856-862) 丢弃 write_io 返回的错误字典（OPC UA 掉线/snap7 写失败不抛异常），写入失败仍返回 status:ok；control_conveyor(\"stop\") 停止失败也误报成功。", "evidence": "server.py 352-357 行 OPC UA 写异常被捕获并 return {'status':'error','error':'OPC UA 写入失败，连接已重置'}（不抛异常）；336-337 行未连接返回 error 字典；go_home 643/645/648/652/653 行 await backend.write_io(...) 无赋值检查，657 行 return {'status':'ok','position':'home',...}；move_arm_to 856/859/861 行同上，908-909 行返回 status:ok；control_conveyor" } ] },
#{ "file": "ai-plc-assistant/backend/generator/scl_generator.py", "findings": [ #{ "severity": "HIGH", "issue": "_ladder_to_scl 的正则只匹配旧单行格式（name--| |--( )--），无法解析 _rungs_to_ascii 生成的 ASCII-LAD-V2 双行格式（名称行在上、--| |--( ) 符号行在下），coils 恒匹配为空并返回 None；导致 /api/generate/ladder/scl 与 /ladder/xml 对 LLM 生成程序只输出 '// TODO: 请根据上方梯形图手动编写 SCL 逻辑' + ';' 空语句，全部梯形图逻辑被静默丢弃", "evidence": "scl_generator.py:160-181 正则 `(\\w+)\\s*\\n?\\s*[-─]*\\(\\s*\\)` 等要求名称与符号同处相邻；_rungs_to_ascii 输出 `bStart  qMotor\\n--| |   --( )`（generate.py:276-285），join 后为 `bStart  qMotor --| |   --( )`，coil 名与 `( )` 间隔 `--| |` 含 `|`，coils=[]→:179 return None→generate_scl:112-117 输出 `// TODO: 请根据上方梯形图手动编写 SCL 逻辑` 与 `;`；调" } ] },
