#{ "file": "plc-code-templates/siemens-scl/pid-control.scl", "findings": [ #{ "severity": "HIGH", "issue": "采样门用 tCycle(IN:=bEnable,PT:=T#200MS) 的 TON.Q 电平信号（使能后每扫描周期恒为 TRUE）而非边沿，PID 计算块实际每周期执行，公式中写死的 0.2s（斜坡步长 rSetpointRampRate*0.2、积分 rKp*rError*0.2/rTi、微分 /0.2）与真实扫描周期不符，斜坡速率/积分时间/微分时间全部失真", "evidence": "plc-code-templates/siemens-scl/pid-control.scl:61 tCycle(IN := bEnable, PT := T#200MS); 第63行 IF tCycle.Q AND bEnable THEN（电平门，无边沿检测）；第72/78行 rSetpointRampRate * 0.2；第105行 rKp * rTd * (rPrevPV - rProcessValue) / 0.2；第114行 rIntegralInc := rKp * rError * 0.2 / rTi；第40行 rSampleTime 声明但全文件未引用；全库 grep 'PI" } ] },
#{ "file": "plc-code-templates/siemens-scl/电梯控制系统.scl", "findings": [ #{ "severity": "HIGH", "issue": "消防归底分支(100-129行)在楼层同步代码(142-150行)之前 RETURN，下行期间 bFloorSensor 同步被跳过、iCurrentFloor 永不更新，电梯无法检测到 1 层到位，只能靠 tonMoveTimeout 15s 超时进入 FAULT，消防归底实际失效", "evidence": "电梯控制系统.scl 行102 IF bFireReturn AND eState <> 4 THEN；行106 IF iCurrentFloor > 1 THEN；行108 tonMoveTimeout(IN := TRUE, PT := tiMoveTimeout)；行110-114 超时置 eState:=4 并 RETURN；行116 bMotorDown := TRUE；行126 RETURN；(行120-124 ELSE 开门分支仅在 iCurrentFloor>1 为 FALSE 时可达)；行143-150 楼层同步块 IF bFloorSensor1..6 THEN iCurr" }, #{ "severity": "MEDIUM", "issue": "249-252行 ELSIF iTargetFloor = iCurrentFloor 在无请求(iTargetFloor=0)且楼层未同步(iCurrentFloor=0)时执行 bUpRequests[0]/bDnRequests[0] := FALSE，数组声明为 Array[1..6]，索引 0 越界访问（每周期重复触发运行时错误）", "evidence": "第59-60行：bUpRequests : Array[1..6] of Bool; bDnRequests : Array[1..6] of Bool;；第196行：iTargetFloor := 0;（IDLE内清空，第199-241行FOR循环仅在有请求时赋值1..6）；第144-150行：仅 bFloorSensor1..6 置位才给 iCurrentFloor 赋值1..6，其余情况保持Int默认值0；第249行：ELSIF iTargetFloor = iCurrentFloor THEN（0=0成立）；第250-251行：bUpRequests[iCurrentFloor] :=" } ] },
#{ "file": "plc-code-templates/siemens-scl/停车场管理系统.scl", "findings": [ #{ "severity": "HIGH", "issue": "cENTRY_VEHICLE_IN/cEXIT_VEHICLE_OUT 防砸逻辑：落杆退出条件要求 NOT bEntranceSafetyLight（光幕被遮挡才落杆），与文档'光幕触发时立即抬杆停止落杆'语义相反；车辆仍压地感且光幕未遮挡、或光幕遮挡而环上无车等组合下两分支均不执行，道闸输出被清零未保持抬起，存在落杆砸车风险", "evidence": "停车场管理系统.scl:197-203 与 267-278：落杆退出条件为 IF NOT bEntranceLoop AND NOT bEntranceSafetyLight THEN eEntryState := cENTRY_GATE_DN，而其注释为'车辆通过后（地感消失且光幕清除），落杆'；同一文件 200-201、211-215 注释'光幕仍有遮挡：保持抬杆'、'防砸检测'的 IF NOT bEntranceSafetyLight THEN 抬杆，确立 NOT bSafetyLight=光幕遮挡。据此真值表：无车+光幕遮挡 → IF 命中 → cENTRY_GATE_DN（209 行" } ] },
#{ "file": "orchestrator/safety_gate.py", "findings": [ #{ "severity": "MEDIUM", "issue": "存在运行中事件循环（即 FastAPI API 服务主路径）时 _run_shadow_check 走 _shadow_sync_fallback，其中 _check_change_rate(tag, value) 使用默认 record_history=True，与 simulate_write 的 record_history=not warnings 不一致：超界/NaN 等被拒写入值也会写入变化率历史基线，违反 shadow_simulator._check_change_rate 明确注释的\"被拒值不得污染基线\"不变量；NaN 基线使 10x 跳变检测比值恒为 False（静默失效），超大值基线会误拒后续合法写入。", "evidence": "safety_gate.py:63-66 运行中事件循环→_shadow_sync_fallback；safety_gate.py:86-92 _check_value_bounds 告警后仍以默认 record_history=True 调 _check_change_rate(tag, value)；shadow_simulator.py:128 if record_history and not warnings 仅查函数内局部变化率告警；shadow_simulator.py:171-173 async 路径传 record_history=not warnings；shadow_si" } ] },
#{ "file": "orchestrator/core.py", "findings": [ #{ "severity": "MEDIUM", "issue": "_call_mcp_sync 用 future.result() 无超时，且整条调用链（McpConnectionPool.call_tool → McpClientAdapter.call_tool → ClientSession.call_tool）均无 wait_for 超时；单个 MCP 服务器挂起不响应会永久阻塞调用线程，并卡死进程级共享 sync-loop 守护线程，后续所有同步工具调用排队挂死且无恢复路径。", "evidence": "core.py:420-425（run_coroutine_threadsafe + future.result() 无超时，_call_tia_read_sync 449 行同类）；core.py:25-42（_get_sync_event_loop 单例守护线程 run_forever）；mcp_pool.py:88（await adapter.call_tool 无 wait_for）；mcp_client.py:191,212-215（await self._session.call_tool 无 wait_for，220 行 except asyncio.TimeoutError 不" }, #{ "severity": "LOW", "issue": "run()/run_adhoc()/_run_dynamic() 均以 all(s.ok for s in context._steps) if context._steps else True 计算结果：空步骤列表（空动态工作流或空 adhoc 步骤序列）被判定为 ok=True 成功，而非拒绝空/非法工作流。", "evidence": "core.py:705/773/802/875/921 均为 `all_ok = all(s.ok for s in context._steps) if context._steps else True`；core.py:146 `_steps: list[StepResult] = field(default_factory=list)`；core.py:667-711 run_adhoc 对空 steps 零迭代直接返回；core.py:656-658 save_dynamic_workflow 无非空校验；tests/test_workflow_error_paths.py:58-61" } ] },
#{ "file": "orchestrator/mcp_owner.py", "findings": [ #{ "severity": "LOW", "issue": "_pid_alive 依赖 os.kill(pid, 0) 存在性探测：Windows 上对不存在的 PID，OpenProcess 失败映射为普通 OSError（非 ProcessLookupError），被 except OSError: return True 捕获，死 PID 恒被判为存活；导致崩溃残留锁在本项目主平台（Windows）永远不会被 _remove_stale_lock 自动清理，后续启动持续 McpOwnerBusyError，只能人工删锁。", "evidence": "orchestrator/mcp_owner.py:26-30（os.kill(pid,0)；except ProcessLookupError→False；except OSError→True）、:107（if _pid_alive(pid): return False）、:59-68（acquire 抛 McpOwnerBusyError）；ai-plc-assistant/backend/main.py:69-74、orchestrator/api.py:139-144（启动锁冲突即失败）；docs/archive/svg_v2_experiment/acceptance_stdout" } ] },
#{ "file": "orchestrator/registry.py", "findings": [ #{ "severity": "LOW", "issue": "register_tool 直接向 self._servers[server_name].tools 追加（无去重），同一工具重复注册（如同一进程内多次 bootstrap，或 register_server 后逐工具注册）会累积重复项，导致 list_tools(server_name) 与 tool_count 失真。", "evidence": "orchestrator/registry.py:132 `self._servers[server_name].tools.append(tool)`（无去重，对照第130行 `self._tools[full_name] = tool` 字典覆盖）；registry.py:151 `return list(server.tools) if server else []`；registry.py:157 `return len(self._tools)`；bootstrap.py:74-76 `registry.register_server(info)` 后 `for tool in to" } ] },
#{ "file": "ai-plc-assistant/backend/routes/orchestrator.py", "findings": [ #{ "severity": "LOW", "issue": "/api/orchestrator/health 端点缺少 Depends(require_local_session)，未授权暴露 servers_connected/workflows/tools 计数，与其余端点鉴权不一致", "evidence": "routes/orchestrator.py L318: '@router.get(\"/health\", response_model=HealthResponse)' 后紧跟 'async def health() -> HealthResponse:'（无 Depends）；L323-326 返回 servers_connected=registry.server_count(), workflows=len(engine.list_workflows()), tools=registry.tool_count()；同文件 grep require_local_session 命中 L33" } ] },
#{ "file": "mcp_common/config.py", "findings": [ #{ "severity": "MEDIUM", "issue": "_looks_like_path 启发式把含 /、\\ 或以 .+2~6 个字母数字结尾的非路径字符串值（如 MODBUS_HOST=plc.local、V2.30、mqtt://…）静默 resolve 为 base_dir 下的绝对路径，配置值被损坏；且 _resolve_path 缺少 tia-mcp config_loader 的 PureWindowsPath 识别，非 Windows 平台上 Windows 路径会被错误拼接", "evidence": "mcp_common/config.py:92 正则 r\"[\\\\/]|\\.[a-z0-9]{2,6}$\" 对 'plc.local'(结尾 .local 5字母)、'V2.30'(结尾 .30 2数字)、'mqtt://…'(含/) 均返回 True，排除表仅覆盖 device_name/http/https/tcp/opc.tcp/IP/_PATH_KEYS；config.py:127-128 _looks_like_path→_resolve_path 静默改写，_resolve_path(94-102行) 将非绝对路径拼 base_dir 后 resolve。调用链: env_confi" }, #{ "severity": "LOW", "issue": "load_yaml_config 遇空文件/null/非 dict YAML 时 Config(None) 构造成功，首次属性访问抛 TypeError: argument of type NoneType is not iterable，缺少清晰的配置错误路径", "evidence": "mcp_common/config.py:107 `object.__setattr__(self, \"_data\", data)` 无类型校验; :116 `if key in data:` → data=None 时 `key in None` 抛 TypeError; :156 `return Config(raw, env, p.parent)` raw 来自 :153 `yaml.safe_load(f)` 未验证; grep 证实全仓无 `isinstance(raw, dict)` 校验; 调用点 mcp-servers/plc-gateway/config.py:74 `tar" } ] },
#{ "file": "mcp_common/connection.py", "findings": [ #{ "severity": "LOW", "issue": "get() 在获取 _sync_lock 之前调用 connect_fn() 建立连接，外层 _instance 检查无锁；跨线程/跨事件循环并发首连会建立两条连接，失败方被丢弃且从不 close（socket 泄漏）；reset() 与 in-flight get() 竞态可撤销重置意图", "evidence": "mcp_common/connection.py 第62行 'if self._instance is None:'（无锁外层检查）；第63行 'async with self._get_async_lock():'；第67-69行 'result = self._connect_fn()' 后 await，期间未持有 _sync_lock；第72-77行赋值段 'with self._sync_lock: if self._instance is None: self._instance = result else: result = self._instance'（失败连接被丢弃、无 cl" } ] },
#{ "file": "mcp_common/audit.py", "findings": [ #{ "severity": "LOW", "issue": "read_logs 按 65536 字节窗口从文件尾向前分块，仅校验块首行完整性；跨块边界的日志行两半都无法解析被 continue 跳过，整条审计条目被静默丢弃且无告警", "evidence": "mcp_common/audit.py:393 (window=65536)、396-401 (从文件尾向前分块、first_line_clean 仅检查 read_from-1 处字节是否为 \\n)、407-408 (lines[1:] 跳过不完整块首行)、409-413 (except json.JSONDecodeError: continue 静默跳过)；对比 _load_last_hash 行241-242、253-255 (window*=4 扩容以解析>64KB条目，read_logs 无此逻辑)；caller 仅 mcp-servers/tia-mcp/audit.py:22 " } ] },
#{ "file": "mcp_common/tiaworker_client.py", "findings": [ #{ "severity": "LOW", "issue": "run() 第 196 行已取得 target，但第 202 行循环内调用 require_control_ip(str(supplied_ip)) 未传 target 参数，导致每个非空 IP 键都重新触发完整 validate_control_target() 校验（多个 IP 键时即 N+1 次重复校验）；函数文档明确支持传入已校验 target 以避免单请求内重复校验。", "evidence": "mcp_common/tiaworker_client.py: run() 第213-227行 try 块内 mkdtemp(214)、NamedTemporaryFile(215-217)、json.dump(219) 无对应 except，仅 finally(308-323) 清理后重抛；全文件唯一 except OSError 在 line 301（仅覆盖 subprocess.run 启动失败）；docstring(172-175) 与其余失败路径(177/198/206/249/257/273/283/296/302)均返回 make_error dict。消费方：mcp-serve" } ] },
#{ "file": "safety/validator.py", "findings": [ #{ "severity": "MEDIUM", "issue": "_check_interlock_rules 对同一 target 的多条规则只评估第一条：循环体所有路径都以 break/return 结束，而加载器用 setdefault(target.upper(),[]).append 明确支持一 target 多规则；一旦 interlock-rules.yml 为同一目标追加第二条规则，其 require_bits/max/min/cooldown 会被静默跳过（fail-open 方向）。当前配置每 target 仅一条规则，属潜伏态。", "evidence": "safety/validator.py:92 setdefault(target.upper(), []).append(rule) 支持一 target 多规则；validator.py:157 for rule in self._rules_by_target.get(tag_key, ()): 循环体 157-221 行内所有路径为 return 或 break（第 196 行非数值无约束时 break、第 220-221 行记录写入时间后 break），无 continue，最多执行一次迭代；validator.py:233-238 _prefetch_required_bits 遍历" }, #{ "severity": "MEDIUM", "issue": "模块级 _MAX_ERRORS=int(_cfg.get(\"safety_max_consecutive_errors\",\"3\")) 对外部 env/.env 值未校验，非数字值在 import 时抛裸 ValueError，拖垮 safety_gate/edge-gateway/plc-mcp-bridge/opcua-mcp 全部 import 方，无 fail-closed 处理与可读错误信息", "evidence": "safety/validator.py:16-18 模块级 _cfg=env_config() 后 _MAX_ERRORS=int(_cfg.get(\"safety_max_consecutive_errors\",\"3\")) 无任何校验/异常处理；mcp_common/config.py:189 default_env 含 \"SAFETY_MAX_CONSECUTIVE_ERRORS\":\"3\" 且 :187 data[key.lower()]=os.getenv(key,default) 直接将外部字符串交给 int()；orchestrator/safety_gate.py:14、edge-" } ] },
#{ "file": "safety/audit.py", "findings": [ #{ "severity": "MEDIUM", "issue": "_read_tail_hash 在链尾只含空白/空行（如日志被截断成单个 \\n）时，lines 为空且 read_from==0 直接返回 \"0\"*64 静默重锚零锚，与其“链尾损坏绝不静默回退零锚重起链”的 fail-closed 文档契约相悖；此边界条件下截断篡改无法被 verify() 检出（mcp_common/audit.py 基类存在同样行为）。", "evidence": "safety/audit.py:48-51: lines=[l for l in tail.splitlines() if l.strip()]; if not lines: if read_from==0: return \"0\"*64（无 AuditStorageError）。mcp_common/audit.py:256-259 同构分支；249-250 空文件(size==0)才走合法零锚早期返回，截断成单个 \\n 时 size=1 不命中。docstring 契约：mcp_common/audit.py:237-242 '绝不静默回退零锚重起链——否则截断旧链+重锚追加的篡改会让 ve" } ] },
#{ "file": "safety/confirmation.py", "findings": [ #{ "severity": "LOW", "issue": "consume 在 isolation_level=None（autocommit）下先执行清理 DELETE 再 INSERT nonce，两步是独立事务；进程在两步之间崩溃时 nonce 未落库，同一一次性令牌可被再次消费，一次性消费语义在崩溃窗口内被削弱。", "evidence": "safety/confirmation.py:54 sqlite3.connect(..., isolation_level=None, ...) 启用 autocommit；confirmation.py:149-155 两条独立 execute（DELETE 清理 + INSERT nonce），无事务包裹；grep 确认全文件无 BEGIN/COMMIT/ROLLBACK/autocommit；tests/test_write_confirmation_gate.py:64-72 显示防重放依赖 INSERT 落库抛 IntegrityError->'已使用'；confirmation." }, #{ "severity": "LOW", "issue": "consume 用 _canonical（sort_keys 的 json.dumps）严格比对 value，_canonical(1500)=\"1500\" 与 _canonical(1500.0)=\"1500.0\" 不相等；签发侧（后端 body.value 为 int）与消费侧（MCP 工具收到 float/字符串）类型漂移时数值相同也必被拒，AI 数值链路中易造成确认令牌误阻断（fail-closed 但脆）。", "evidence": "safety/confirmation.py:23-24 定义 _canonical=json.dumps(ensure_ascii=False, sort_keys=True, separators=(\",\",\":\"))；:134 consume 用 _canonical(payload.get(\"value\")) != _canonical(value) 严格比较并抛 ConfirmationError(\"确认令牌值不匹配\")。签发端 ai-plc-assistant/backend/routes/orchestrator.py:177-180 ConfirmationRequest.va" } ] },
#{ "file": "safety/shadow_simulator.py", "findings": [ #{ "severity": "MEDIUM", "issue": "_load_safe_tags 只捕获 ImportError；safety.validator 的任何非 ImportError 导入失败（如第1条触发的 ValueError）会穿透 PreWriteChecker.__init__，模块级单例 shadow_sim=PreWriteChecker() 构造失败致整个模块不可导入，注释承诺的降级内置硬编码禁止列表不会生效", "evidence": "safety/shadow_simulator.py:73-81 try/except ImportError 仅捕获 ImportError；:66 __init__ 调用 self._load_safe_tags()；:191 shadow_sim = PreWriteChecker() 模块级执行；safety/validator.py:16-17 模块级 `_cfg = env_config()` 与 `_MAX_ERRORS = int(_cfg.get(\"safety_max_consecutive_errors\", \"3\"))` 可于 import 时抛 ValueError；m" } ] },
