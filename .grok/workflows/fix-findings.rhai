#{ "file": "plc-code-templates/siemens-scl/cooling-tower.scl", "findings": [ #{ "severity": "MEDIUM", "issue": "bFlowAlarm(110行)/bPressureAlarm(124行)/bAntiFreezeAlarm(135行)只在触发分支置 TRUE，故障复位块(85-92行)仅清 bFlowTrip/bPressureTrip/bTempTrip/bFreezeTrip 标志，三个报警输出无任何位置置 FALSE（已 grep 确认），瞬时故障后报警永久锁存无法复位", "evidence": "grep 全部出现点：bFlowAlarm 仅 29(声明)/110(:=TRUE)；bPressureAlarm 仅 30/124(:=TRUE)；bAntiFreezeAlarm 仅 32/135(:=TRUE)；无任何 :=FALSE。复位块 85-91 行 IF bFault AND bReset THEN 仅清 bFault/bFlowTrip/bPressureTrip/bTempTrip/bFreezeTrip(88-89行)。对照组 239 行 bTempHighAlarm := FALSE（235 行置 TRUE 成对）。触发路径 108-112/122-126/133-13" } ] }
];

// 分批修复：args.start / args.count 按文件切片，每批默认最多 64 个修复子代理。
let batch_start = if args == () { 0 } else { if args.start == () { 0 } else { args.start } };
let batch_count = if args == () { 64 } else { if args.count == () { 64 } else { args.count } };
let batch = [];
let end = batch_start + batch_count;
if end > jobs.len() { end = jobs.len(); }
let idx = batch_start;
while idx < end { batch.push(jobs[idx]); idx += 1; }
log("本批修复 " + batch.len().to_string() + " 个文件（jobs[" + batch_start.to_string() + " .. " + end.to_string() + ")）");

phase("Fix");
let fjobs = [];
for j in batch {
    let desc = "";
    for fd in j.findings {
        desc += "- [" + fd.severity + "] " + fd.issue;
        if fd.evidence != "" { desc += "（证据：" + fd.evidence + "）"; }
        desc += "\n";
    }
    fjobs.push(#{
        prompt: "修复文件 " + j.file + " 中以下已确认缺陷（每条含严重度与验证证据）：\n" + desc
            + "要求：\n1. 先用 read_file 读取该文件及相关代码，理解上下文后再动手；\n"
            + "2. 用 search_replace 等工具做最小改动修复每个缺陷，保持现有代码风格，不做无关重构；\n"
            + "3. 只修改 " + j.file + " 这一个文件；若某缺陷必须跨文件修改才能修复，先完成本文件可改部分，并在 notes 里说明需要的跨文件改动；\n"
            + "4. 严禁破坏安全机制（认证/令牌/互锁/审计链/fail-closed 语义），严禁硬编码密钥或凭据；修复方向是让系统更安全、更 fail-closed；\n"
            + "5. 修复后如该文件有相关测试，运行并确认通过；\n"
            + "6. 输出 files_changed（实际修改的文件列表）、summary（逐处改动说明）、notes（风险、跨文件依赖、需人工确认项，如工艺逻辑需复核）。",
        label: "fix:" + j.file,
        capability_mode: "read-write",
        output_schema: fix_schema,
    });
}
log("本批派出 " + fjobs.len().to_string() + " 个修复子代理");
let results = parallel(fjobs);

let done = [];
for r in results {
    if r != () && r.success {
        done.push(r.output);
    }
}
log(done.len().to_string() + "/" + fjobs.len().to_string() + " 个文件修复完成");
complete(#{ summary: done.len().to_string() + " 个文件修复完成（" + (fjobs.len() - done.len()).to_string() + " 个失败或未完成）", fixed: done });
