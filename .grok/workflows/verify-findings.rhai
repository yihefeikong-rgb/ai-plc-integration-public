#{ "file": "ai-plc-assistant/backend/storage/projects.py", "issue": "ProjectStore 在 check_same_thread=False 的共享 sqlite3 连接上执行读写且无锁（ConversationStore 有 _lock），FastAPI 线程池并发请求会并发操作同一连接，事务交错/非确定性提交顺序，可能触发 database is locked 或脏读。", "severity": "MEDIUM" },
