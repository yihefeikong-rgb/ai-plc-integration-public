let meta = #{
    name: "verify-findings",
    description: "对抗性验证项目全面审查第一轮的 469 条未验证原始发现，只输出有证据支撑的结论。",
    when_to_use: "对已产出的发现清单做第二轮对抗验证",
    phases: [
        #{ title: "Verify", detail: "每条发现一个质疑者" },
    ],
};

let verdict_schema = #{
    "type": "object", "required": ["real", "reason", "evidence"],
    "properties": #{
        "real": #{ "type": "boolean" },
        "reason": #{ "type": "string" },
        "evidence": #{ "type": "string" },
    },
};

let findings = [
#{ "file": "mcp_common/config.py", "issue": "env_config() 把 SAFETY_WRITE_CONFIRM 以字符串默认 'true' 暴露且无类型/取值校验，validator 据此整体关闭写入人工确认；_resolve_env 对无默认值 ${VAR} 解析为空串（fail-open）。缺环境变量时可静默禁用安全确认而无任何告警。", "severity": "LOW" },
#{ "file": "mcp-servers/plc-mcp-bridge/tools_s7.py", "issue": "人工确认令牌消费端 target 绑定为物理地址 canonical_address，而唯一签发端点(ai-plc-assistant/backend/routes/orchestrator.py)仅对语义目标(如 DB1.MotorSpeed)签发、对物理地址目标因 needs_confirmation=False 拒绝签发：token 永远无法被消费，双人确认写入闸门端到端死路，任何需要确认的写入恒被拦截。", "severity": "HIGH" },
#{ "file": "edge-gateway/src/app.py", "issue": "AI 控制循环用 decision['target'] 直接 validate 并直接 write_func 写入，从不调用 validator.resolve_s7_write_address 白名单、也从未 set_bit_reader；互锁规则按 DB1.* 语义名匹配而此处传入的是 M0.1/MW14 物理地址，require_bits（急停互锁）与地址允许列表在网关路径全部失效，LLM 可直接写电机/泵位。", "severity": "HIGH" },
#{ "file": "safety/validator.py", "issue": "_check_interlock_rules 规则匹配 rule.get('target') == tag_name 大小写敏感，而 FORBIDDEN/CONFIRM 检查均用 tag_upper 归一化；大小写变体标签(如 db1.motor_run)可绕过 require_bits/max/min/cooldown 互锁(潜在 fail-open)。", "severity": "MEDIUM" },
#{ "file": "safety/validator.py", "issue": "_check_interlock_rules 中 float(value) 抛 (ValueError,TypeError) 时直接 return None，非数值写入(字符串/对象)跳过 max/min/cooldown 与全局范围检查，可获 allowed=True，数值互锁规则对非数值值失效。", "severity": "MEDIUM" },
#{ "file": "safety/shadow_simulator.py", "issue": "_check_change_rate 无论是否产生告警都把 value 追加进 _history，被拒(超界/跳变)的写入值污染历史，后续合法写入按被拒值计算跳变率而被误拒(连续误拒还可能累计 validator 侧计数)。", "severity": "MEDIUM" },
#{ "file": "orchestrator/safety_gate.py", "issue": "reset_fuse 消费令牌 target='safety.fuse_reset'，但后端 /confirmations 签发的 fuse_reset 令牌 target='{device_namespace}.fuse_reset'(如 modbus.fuse_reset)，永远不匹配；且无任何路由调用该 reset_fuse，其 WriteValidator 也非 MCP 服务器进程内的同一实例，熔断重置路径实际不可用。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "写失败路径直接 safety_validator.consecutive_errors += 1，绕过 WriteValidator._lock，与 validate()/reset_fuse() 加锁的读-改-写构成非原子竞争(丢失递增/复位)；同文件 mitsubishi-mcp/server.py 亦同。且两服务器无任何 reset_fuse 工具，熔断后只能重启进程恢复。", "severity": "MEDIUM" },
#{ "file": "safety/confirmation.py", "issue": "used_confirmation_tokens 表只 INSERT 不清理，长期运行无限增长；consume 用显式 BEGIN IMMEDIATE...COMMIT，进程在 INSERT 与 COMMIT 之间崩溃时事务回滚，同一令牌可被二次消费(单个批准授权两次写入)。", "severity": "LOW" },
#{ "file": "safety/validator.py", "issue": "_load_interlock_rules() 在规则文件缺失或解析/校验异常时仅记录日志后继续运行，_rules 与 _s7_write_addresses 保持为空；全部互锁规则（require_bits 安全位前置条件、max/min、cooldown）被静默禁用，validate() 对非急停前缀的数值标签只做 ±1M 通用检查即放行，属 fail-open", "severity": "CRITICAL" },
#{ "file": "safety/validator.py", "issue": "_check_interlock_rules() 中 float(value) 失败时直接 return None，跳过该标签整条规则的 max/min/cooldown 检查，而全局检查同样跳过非数值，导致 validate() 对非数值写入返回 allowed=True，数值边界约束被绕过", "severity": "MEDIUM" },
#{ "file": "safety/validator.py", "issue": "_bit_reader 回调调用无 try/except；回调抛异常时异常从 validate() 逃逸，既不返回 ValidationResult(False) 也不递增熔断计数器；modbus/mitsubishi/opcua 服务器无保护直调 validate()，原始异常（可能含通信细节）冒泡到 MCP 客户端", "severity": "MEDIUM" },
#{ "file": "safety/confirmation.py", "issue": "consume() 的 except 分支直接执行 ROLLBACK；当 BEGIN IMMEDIATE 因 database is locked 失败时无活动事务，ROLLBACK 自身抛裸 sqlite3.OperationalError，掩盖真实错误并向只捕获 ConfirmationError 的调用方泄露 sqlite 内部错误", "severity": "MEDIUM" },
#{ "file": "mcp_common/audit.py", "issue": "_load_last_hash() 以 except Exception: pass 吞掉日志读取/JSON 解析错误并返回 0x64，审计链尾部损坏或截断时哈希链被静默重置，后续写入从新链继续追加，篡改在写入时刻不被察觉（safety/audit.py 重新导出该实现）", "severity": "MEDIUM" },
#{ "file": "safety/shadow_simulator.py", "issue": "_load_safe_tags() 捕获 ImportError 后静默回退到硬编码禁止标签列表且无日志；若 safety.validator 因依赖等原因导入失败，禁止写入标签保护静默降级且当前回退列表与 FORBIDDEN_PATTERNS 的同步无任何机制保障", "severity": "LOW" },
#{ "file": "safety/confirmation.py", "issue": "issue() 无错误处理，value 含不可 JSON 序列化对象时 _canonical() 抛裸 TypeError 冒泡给仅捕获 ConfirmationError 的调用方，内部异常直接暴露", "severity": "LOW" },
#{ "file": "safety/validator.py", "issue": "resolve_s7_write_address() 对『地址非法』与『互锁规则文件加载失败』都返回 None，调用方无法区分配置加载失败与正常未映射地址，配置错误被记成普通拒绝而掩盖，无告警升级路径", "severity": "LOW" },
#{ "file": "safety/validator.py", "issue": "validate() 在持有 self._lock 期间调用 _bit_reader 执行 PLC 位读取（网络 I/O），每个 require_bits 位一次独立往返；所有并发写校验被串行化在 PLC 往返延迟之后", "severity": "HIGH" },
#{ "file": "safety/audit.py", "issue": "每次 audit.log（经 safety/audit 再导出的 mcp_common/audit.py AuditLogger._write_entry）重开文件 3 次并 seek 重读至多 65536 字节尾部只为取最后一行 hash，逐写入的磁盘 I/O 叠加", "severity": "MEDIUM" },
#{ "file": "safety/shadow_simulator.py", "issue": "simulate_write 固定 await asyncio.sleep(0.01) 人为延迟；SafetyGate 在无事件循环时每次写都 asyncio.run 新建事件循环跑该延迟，并另写 _shadow_sync_fallback 重复实现同一套检查逻辑", "severity": "MEDIUM" },
#{ "file": "safety/validator.py", "issue": "_check_interlock_rules 每次 validate 都线性扫描全部 write_rules 匹配 target，未在加载时按 target 建 dict 索引", "severity": "LOW" },
#{ "file": "safety/validator.py", "issue": "同一数值被重复转换：float(value) 在互锁范围、全局范围、跳变检测三处重复计算，float(current_value) 同样重复转换", "severity": "LOW" },
#{ "file": "safety/shadow_simulator.py", "issue": "_check_change_rate 与 validator 第 5 步跳变检测语义重复、各维护一套历史状态，每次写校验重复计算变化率", "severity": "LOW" },
#{ "file": "safety/shadow_simulator.py", "issue": "_history 字典按 tag 条目上限 5 但 tag 键数量无上限且永不清除，长时间运行内存缓慢增长", "severity": "LOW" },
