#{ "file": ".env", "issue": "根目录 .env 以明文持久化真实 API Key 与 InfluxDB 凭据（已 gitignore 未提交），且 SAFETY_CONFIRMATION_SECRET、AUDIT_HMAC_KEY 未配置，确认令牌与持久审计链在默认部署下不可用；报告不含密钥明文", "severity": "LOW" },
#{ "file": "edge-gateway/src/app.py", "issue": "AI 决策 target 未校验是否属于 available 白名单，且 safety_validator.validate 收到的是地址而非标签名，FORBIDDEN/CONFIRM 名称模式与 DB1.* 互锁规则全部失效，急停标签(M1.2)/任意 S7 地址可被直接写入，needs_confirmation 恒为 False", "severity": "CRITICAL" },
#{ "file": "edge-gateway/src/change_detector.py", "issue": "has_significant_change 中配置 delta 后仍回退到 value != prev，小幅变化(小于 delta)也会判定显著变化并触发 AI，delta 阈值过滤完全失效，与自身 docstring 矛盾", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/change_detector.py", "issue": "is_out_of_bounds 直接索引 limits[\"min\"]/limits[\"max\"]，阈值仅配置 delta 时抛 KeyError，非数值 value 时抛 TypeError；异常上抛使整个 ai_control_loop 每周期对所有标签失效", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/app.py", "issue": "safety_validator.validate 未传 current_value，validator 的 10 倍值跳变保护要求 current_value 非 None，该安全保护在本路径被静默禁用", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/app.py", "issue": "同步阻塞调用 S7 write_address 与 InfluxDB SYNCHRONOUS 写入在 asyncio 事件循环中执行，PLC/InfluxDB 不可达时阻塞整个扫描循环", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/app.py", "issue": "modbus_read 在 rr.isError() 时返回 {\"value\": None} 未标 status=error，通信故障被当作正常读取，ok_n 显示假 OK，InfluxDB/AI 无感知", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/app.py", "issue": "先执行 write_func 再 audit.log，审计写入失败时控制副作用已发生却无审计记录，违反审计应先行于控制副作用的 fail-closed 语义", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/app.py", "issue": "ai.analyze_data 调用位于 try 块之外，AI 网络异常直接中断本轮全部标签的决策且不计入熔断计数，无重试降级", "severity": "LOW" },
#{ "file": "edge-gateway/src/app.py", "issue": "写入失败仅 print 后被吞，随后 audit.log('ai_decision') 使用默认 success=True，把失败的写操作记入 HMAC 审计链为成功决策，失败路径无持久化错误信息，破坏审计完整性", "severity": "HIGH" },
#{ "file": "edge-gateway/src/app.py", "issue": "InfluxDB 客户端初始化用裸 except Exception 且无任何日志，配置了遥测却静默降级为 HAS_INFLUX=False，异常被吞掉无法排查", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/app.py", "issue": "ai.analyze_data() 调用位于 try 块之外，API 超时/认证失败仅被 run() 兜底 except print 吞掉，不计入 _ai_json_fail_count 熔断，也无日志落盘", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/app.py", "issue": "run() 主循环 except Exception 只 print 不记录日志/审计、无退避重试，持续失败时 30s 空转，Docker 无头运行下错误不可追溯", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/app.py", "issue": "s7.connect() 返回值仅 print 不检查，连接失败后网关仍继续运行，所有读操作持续报错，失败路径未处理", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/app.py", "issue": "Modbus 模式 modbus_client.connect() 在 try 之外，连接失败未处理直接崩溃；modbus_read 未识别标签类型静默返回 {'value': None} 被当作 ok 状态", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/change_detector.py", "issue": "abs(value-prev) 与 value<limits['min']/max 假定读值必为数值且阈值键完整，非数值读值或阈值只含单键时抛 TypeError/KeyError，被上层 print 吞掉并跳过整批 AI 处理", "severity": "MEDIUM" },
#{ "file": "edge-gateway/src/app.py", "issue": "str(e) 原始异常文本（含 snap7/连接细节，可能带 PLC 地址）经 print 输出并存入 scan 结果，无脱敏与结构化日志，stdout 被采集时泄露网络拓扑细节", "severity": "LOW" },
#{ "file": "edge-gateway/src/app.py", "issue": "InfluxDB 使用 SYNCHRONOUS 写 API 且逐 tag 单点写入，在 asyncio 事件循环中直接同步阻塞；每采集周期最多 13 次串行阻塞 HTTP POST，DB 不可达时重试会拖垮整个网关循环，未用 asyncio.to_thread 或批量 write", "severity": "HIGH" },
#{ "file": "edge-gateway/src/app.py", "issue": "s7_read 为 async 但内部直接调用同步阻塞的 snap7 read_address（mb_read/db_read 网络往返），s7_write 为纯同步函数在事件循环内同步调用，每次 PLC 往返都冻结整个事件循环", "severity": "HIGH" },
