#{ "file": "plc-code-templates/siemens-scl/新风热回收控制.scl", "issue": "206/207/255行 ABS(rOutdoorTemp-rIndoorTemp) 重复计算3次且257行 ABS(rIndoorTemp-rOutdoorTemp) 为同一绝对值换序重算；214/221行预热误差表达式亦重复2次；ABS与除法均相对昂贵", "severity": "LOW" },
#{ "file": "plc-code-templates/siemens-scl/VAV变风量末端控制.scl", "issue": "165/171行 (rRoomTemp - rCoolSetpoint) 重复计算2次；235行 rAirflowMin*0.3 在限幅条件与赋值中各算一次", "severity": "LOW" },
#{ "file": "plc-code-templates/siemens-scl/智能照明控制.scl", "issue": "129行 tofVacancy 的 PT:=INT_TO_TIME(iDelayOff*1000) 中 iDelayOff 为固定VAR，但乘法与类型转换每个扫描周期重复求值，应预计算为Time常量", "severity": "LOW" },
#{ "file": "plc-code-templates/siemens-scl/电梯控制系统.scl", "issue": "声明了运行超时保护（tonMoveTimeout/tiMoveTimeout，默认15s）但全文件从未调用；电梯卡梯或楼层传感器失效时电机可无限运行，与md承诺的'运行超时→故障报警'矛盾", "severity": "HIGH" },
#{ "file": "plc-code-templates/siemens-scl/电梯控制系统.scl", "issue": "关门状态退出条件为 tonDoorClose.Q OR bDoorClosed，仅凭3s定时器到期即可开门锁未确认的电梯进入IDLE→MOVING驱动电机，违反md安全规则'门锁未闭合→禁止运行'", "severity": "HIGH" },
#{ "file": "plc-code-templates/siemens-scl/conveyor-with-timer.scl", "issue": "停止按钮需持续按住3s才生效；瞬时按下会被 'IF NOT bStop AND bSafetyOK THEN tStopDelay(IN:=FALSE)' 清零，运行命令保持，停止命令可被忽略", "severity": "MEDIUM" },
#{ "file": "plc-code-templates/siemens-scl/cooling-tower.scl", "issue": "bStop 段清空泵输出后，泵控段同一扫描周期以 'IF bEnable OR bChillerInterlock THEN bPumpRun:=TRUE' 重新置位，Stop 状态下循环泵仍继续运行", "severity": "MEDIUM" },
#{ "file": "plc-code-templates/siemens-scl/楼宇自控HVAC系统.scl", "issue": "防冻模式 eMode:=4 触发后无任何复位路径（恢复只清 bFreezeAlarm，模式选择被 'IF eMode<>4' 跳过，bReset 不复位 eMode），AHU 防冻事件后永久死锁于 FREEZE_PROTECT", "severity": "MEDIUM" },
#{ "file": "plc-code-templates/siemens-scl/cip-system.scl", "issue": "bDrainValve 在 RINSE1 结束时置 TRUE 后，后续 CAUSTIC/RINSE2/ACID/FINAL_RINSE 阶段从不复位，碱液/酸液在整个清洗循环持续向排空口排放", "severity": "MEDIUM" },
#{ "file": "plc-code-templates/siemens-scl/pump-station.scl", "issue": "错时启动 tStagger.Q 分支只对 bRunCmd1 赋值，bRunCmd2/3/4 保持 FALSE，多泵分档运行退化为单泵，轮值/加减泵逻辑失效", "severity": "MEDIUM" },
#{ "file": "plc-code-templates/siemens-scl/motor-control.md", "issue": "急停/过载置 iState:=3(FAULT) 后模板无 bReset 输入、无故障复位路径，任何急停或过载事件后电机控制块永久锁存无法重新启动", "severity": "LOW" }
];

// 分批验证：通过 args.start / args.count 指定本批范围，每批最多 128 条，防止一次派出过多子代理拖垮本机。
let batch_start = if args == () { 0 } else { if args.start == () { 0 } else { args.start } };
let batch_count = if args == () { 128 } else { if args.count == () { 128 } else { args.count } };
let batch = [];
let end = batch_start + batch_count;
if end > findings.len() { end = findings.len(); }
let idx = batch_start;
while idx < end { batch.push(findings[idx]); idx += 1; }
log("本批验证范围：findings[" + batch_start.to_string() + " .. " + end.to_string() + ") 共 " + batch.len().to_string() + " 条");

phase("Verify");
let vjobs = [];
for f in batch {
    vjobs.push(#{
        prompt: "对抗性验证下面这条审查发现，必须实际读取代码确认，不能只凭审查者转述。发现：\"" + f.issue + "\"，文件：" + f.file
            + "，声称严重度：" + f.severity + "。只有在你能独立检查到具体证据（如具体行、调用链、配置项）时才设 real=true；"
            + "证据不足、无法复现、描述模糊或文件不存在一律设 real=false，reason 说明理由，evidence 给出你独立看到的证据（含文件与行号）。",
        label: "verify:" + f.file,
        capability_mode: "read-only",
        output_schema: verdict_schema,
    });
}
log("验证阶段将派出 " + vjobs.len().to_string() + " 个子代理");
let verdicts = parallel(vjobs);

let confirmed = [];
let i = 0;
for v in verdicts {
    if v != () && v.success && v.output.real == true
        && v.output.evidence != () && v.output.evidence != "" {
        confirmed.push(batch[i]);
    }
    i += 1;
}
log(confirmed.len().to_string() + "/" + findings.len().to_string() + " 条发现通过对抗验证");
complete(#{ summary: confirmed.len().to_string() + " 条确认发现（其余已被质疑者驳回）", confirmed: confirmed });
