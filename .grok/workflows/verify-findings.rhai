#{ "file": "mcp-servers/plc-gateway/contracts/safety_chain.py", "issue": "确认门控可被调用方自传 confirmed=True 直接放行，无真人确认证据；全仓 create_token 无任何调用者，确认/预览令牌在运行中永远不会签发，SafetyChain.check_all/atomic_apply 均无调用方，HMAC 认证与审计链在真实写入路径上从未生效", "severity": "CRITICAL" },
#{ "file": "mcp-servers/plc-gateway/workflows/guarded_apply.py", "issue": "guarded_apply_execute 不重新执行 validate_guarded_apply，绕过受保护块（OB1/OB100/OB121/OB122）与允许操作白名单；含 delete_network/replace_network/insert_network 且针对 OB1 的 patch 可在 confirmed=True 下直接下发", "severity": "HIGH" },
#{ "file": "mcp-servers/plc-gateway/providers/tiacommander.py", "issue": "Provider 层 apply_patch 对块名/受保护块/操作类型零校验（比策略白名单更宽松，可执行 delete/replace/insert network）；preview_patch 恒返回 ok=True 无真实预览；_call 将工具返回的错误文本也视为成功", "severity": "HIGH" },
#{ "file": "mcp-servers/plc-gateway/contracts/preview_apply.py", "issue": "AuditLog.set_log_dir 全仓无调用者，审计链从不落盘、仅存内存重启即失；无密钥时 _compute_chain_hash 退化为裸 SHA-256 可伪造；确认动作本身不产生任何审计事件，确认者身份不可追溯", "severity": "MEDIUM" },
#{ "file": "mcp-servers/plc-gateway/workflows/guarded_apply.py", "issue": "guarded_apply_preview 中 from workflows.network_patch import ... 导入路径错误（无顶层 workflows 包，应为 plc_gateway.workflows.network_patch），预览闸门必然抛 ImportError，受控 Apply 的预览+Hash 快照检查实际不可用", "severity": "MEDIUM" },
#{ "file": "mcp-servers/plc-gateway/workflows/network_patch.py", "issue": "tia_apply_block_patch 预览后直接调用 apply_patch，无确认令牌、无审计记录；预览返回的 requires_confirmation=True 无任何执行方强制，与 registry 中 L2 工具 requires_confirmation 元数据声明脱节", "severity": "MEDIUM" },
#{ "file": "mcp-servers/plc-gateway/contracts/safety_chain.py", "issue": "check_confirmation 用裸 validate_token 验证 confirmation_token，不绑定 project_path/target_hash/device_id，且与预览令牌共用同一令牌池，任意预览令牌可充当确认令牌，违背宣称的项目/目标/设备绑定检查", "severity": "MEDIUM" },
#{ "file": "mcp-servers/plc-gateway/workflows/network_patch.py", "issue": "block_name 等外部输入无格式校验（server.py 原样透传至 Provider 载荷）；validate_patch 定义了 _load_schema 却从不使用 network_patch.schema.json，自实现校验弱于 Schema；另 GATEWAY_SAFETY_ENABLED=0 可一次性关闭整个安全链", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "write_node 将 OPC UA node_id（ns=3;s=DB1.X）作为 tag_name 传给 safety_validator.validate()，而 safety/interlock-rules.yml 的 write_rules 用纯标签名（DB1.X）做精确相等比较，导致 require_bits、max/min、cooldown 等全部互锁规则对 OPC UA 写入永不匹配、静默失效；未列入 opcua_safety.VALUE_LIMITS（仅 4 个节点）的其他标签可写入任意数值。", "severity": "HIGH" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "value 以原始字符串传给 validator.validate() 和 shadow_sim.simulate_write()，而这两个模块的数值检查（全局 100 万上限、有限数、跳变检测、越界/变化率）都要求 isinstance(value,(int,float))，字符串时全部静默跳过；对比 modbus-mcp 传的是 bool/int 类型值。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "一次性确认令牌在影子仿真、互锁读取、范围检查和实际写入之前就被 confirmation_service.consume() 消费；后续任一检查拒绝或写入失败时令牌已作废，被确认的操作并未发生，操作者需重新签发令牌。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "data_type='auto' 时已读取节点真实 vtype 却未按其转换，_convert_value 只按字符串文本推断 Python 类型；已核实 asyncua 序列化行为：小数串写入整数节点触发 struct.error、数字串写入 String 节点触发 AttributeError，合法输入在默认模式下报错并累加熔断计数。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "browse 的 depth 由调用方任意传入且无上限，_browse_recursive 每层最多 50 个孩子、深度无总预算，depth=4 时最坏 50^4 次异步节点读取，可导致工具长时间挂起或内存耗尽。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "模块级全局 _client/_endpoint 无同步：connect 先判空再 await client.connect() 存在 TOCTOU 竞态；连接掉线后 _client 仍非 None，opcua_connect 一直拒绝重连，读写持续失败直到显式 disconnect，无健康探测。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "_convert_value 的 bool 分支对任何不在 ('true','1','yes','on') 中的字符串（拼写错误、'0'、'off'、空串、'2'）一律静默返回 False，意图值被静默反转且无任何报错。", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/opcua_safety.py", "issue": "record_write 把互锁/范围拒绝这类正常保护性拒绝也以 success=False 计入熔断连续错误计数，3 次正常拒绝即永久熔断全部写入；且熔断后每次被拒写入仍继续递增 consecutive_errors，无限增长超过 max_errors。", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "write_node 中 _convert_value 在 try 块外调用（server.py:332,408-409），data_type=int/float 且值非法时 ValueError 未捕获，写入尝试绕过审计与熔断记录，原始异常/回溯直接返回给客户端", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "disconnect 使用裸 except Exception: pass（server.py:146-149）吞掉断开失败，随后无条件清空 _client/_endpoint，底层连接未真正关闭时遗留泄漏句柄且无任何日志", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/opcua_safety.py", "issue": "check_value_range 对非数值输入静默返回 OK（跳过范围检查）（opcua_safety.py:132-134），配合 data_type=auto 时字符串值可绕过 VALUE_LIMITS 数值范围直达写入，失败路径无警告", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "connect/read_node/browse 将原始异常文本 {e} 直接拼进返回消息（server.py:128,202,229），向客户端泄露连接/网络/内部实现细节，缺少异常脱敏", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/opcua_safety.py", "issue": "check_interlock 互锁节点读取失败时把原始异常文本写入 reason（opcua_safety.py:82），异常细节进入审计日志及客户端可见消息，且该失败不自行记录熔断计数，完全依赖调用方", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "_browse_recursive 使用裸 except Exception: pass（server.py:238-240）静默吞掉子节点枚举/读取异常，浏览结果静默不完整且不可排查", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/opcua_safety.py", "issue": "check_interlock_lenient 死代码中 except Exception: pass 在互锁读取失败时静默跳过安全互锁检查（opcua_safety.py:103-113），与 fail-closed 策略矛盾，一旦接线即构成安全旁路", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "模块级安全链导入（server.py:56-63 的 safety.validator/shadow_simulator/mcp_common.*）无异常保护，任一依赖缺失即启动崩溃并输出裸 traceback，与 mcp/asyncua 导入的友好降级不一致", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "_browse_recursive 对每个子节点串行 read_browse_name()（N+1 往返），默认 depth=2/每层50子节点时单次 opcua_browse 最多约2550 次串行 await，应改用 get_children_descriptions()/browse() 批量取回 BrowseName", "severity": "HIGH" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "read_node 用 read_value()+read_data_type_as_variant_type() 两次串行 Read 往返取值和类型，可用 read_data_value() 一次返回含 VariantType 的 DataValue", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/opcua_safety.py", "issue": "check_interlock 每次写入都串行读取急停位和安全OK位两个节点，无批处理（client.read_values 可合并为一次往返）也无短缓存，连续写同一标签重复读", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "成功写一次触发3次文件追加：begin_control_operation + safety.record_write(FileHandler同步落盘) + _audit.log，同一事件被两套审计重复记录，且审计每次做跨进程阻塞锁和日志尾部重读", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "data_type=auto 时 _convert_value 的 bool/int/float 推断结果被 ua.Variant(converted,vtype) 按服务端类型强制覆盖，推断白做；且每次写同一节点都重读 read_data_type_as_variant_type() 不缓存", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "同一 value 字符串在 validator 规则检查、opcua_safety.check_value_range(_convert_value 链中被重复 float()/int() 解析2-3次，属无意义重复计算", "severity": "LOW" },
#{ "file": "safety/shadow_simulator.py", "issue": "simulate_write 硬编码 await asyncio.sleep(0.01) 模拟延迟，opcua 每次写入都额外增加10ms固定延迟，真实控制链上不必要", "severity": "LOW" },
#{ "file": "mcp_common/audit.py", "issue": "每次审计条目 _load_last_hash() 重读日志末尾最多64KB、_ensure_storage_writable 每次打开文件、Windows 下 msvcrt.locking 阻塞式加锁；opcua 每次写入执行2次该路径，阻塞异步事件循环", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "write_node 接受任意 OPC UA 节点 ID；safety/validator.py 的互锁规则以裸标签精确相等匹配（如 'DB1.MotorSpeed'），对 'ns=3;s=DB1.MotorSpeed' 形式永不命中，require_bits/范围/冷却互锁全部失效；实际仅有 2 个硬编码节点互锁和 4 个节点的 VALUE_LIMITS，其余任意可写节点无范围限制、无位互锁、无确认", "severity": "HIGH" },
#{ "file": "mcp-servers/opcua-mcp/opcua_safety.py", "issue": "check_interlock_lenient 为 fail-open 急停绕过：急停/安全节点读取异常时 except:pass 放行写入，docstring 宣称适用于测试环境；虽当前 server.py 未引用，但作为公开 API 随模块分发，属急停与安全逻辑可被触碰的潜在路径", "severity": "HIGH" },
#{ "file": "mcp-servers/opcua-mcp/opcua_safety.py", "issue": "record_write/trip_fuse 写入独立 logs/opcua_audit.log，纯明文 JSON、无链式哈希、无操作者身份，FUSE_TRIPPED 事件仅落在此日志，绕过 mcp_common.audit 的 HMAC 审计链，可被篡改且不参与链校验", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/opcua_safety.py", "issue": "互锁节点名硬编码 ns=3;s=DB1.EmergencyStop/DB1.SafetyOK，与 interlock-rules.yml 的目标语义（EmergencyStopOff/SafetyOK，且注释明确实际工程未定义急停极性）不一致，可能读错信号或永远 fail-closed；熔断器状态仅存进程内存，重启即自动清除，熔断可被进程重启绕过", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "Client(url=endpoint) 无用户名/密码/安全模式，OPC UA 读写数据与写入命令在网络上明文传输（control_target 仅校验端点语法，不强制加密/认证），对真实 S7-1200/1500 设备控制边界不足", "severity": "MEDIUM" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "_require_auth 使用 '!=' 非常量时间比较令牌（非 hmac.compare_digest），存在时序侧信道；auth_token 作为参数随每次 MCP 工具调用带内传输", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/server.py", "issue": "确认令牌在影子仿真/互锁/范围检查之前被 consume（顺序倒置）：后续任一安全检查拒绝或写入失败时一次性确认令牌已被提前烧掉，人工确认记录与实际写入不对应", "severity": "LOW" },
#{ "file": "mcp-servers/opcua-mcp/opcua_safety.py", "issue": "check_value_range 在 float(value) 转换失败（bool/字符串）时返回 True（跳过范围检查），对 VALUE_LIMITS 中数值受限节点可绕过 min/max 边界", "severity": "LOW" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "build_write_request 将写值静默掩码为 16 位（value & 0xFFFF）；validator 允许 abs<=1,000,000，导致如 70000 被静默写成 4464，用户批准的值与实际写入 PLC 的值不一致", "severity": "HIGH" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "struct.pack('<I', offset)[:3] 对 >=0x1000000 的偏移静默截断回绕，如 D16777216 实际读写 D0，静默命中错误设备", "severity": "HIGH" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "get_connection 的 _reader is None 检查与 open_connection 之间无锁，并发调用会重复建连泄漏 socket，并共享同一流导致请求/响应帧交错错配，可能返回错误设备的值", "severity": "HIGH" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "全局 _reader/_writer 永不过期重连，无 EOF 检查；连接断开后（如 PLC 重启）所有后续读写永久失败", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "单次 r.read(1024) 在 TCP 分段下可能返回半帧；parse_read_response 不校验响应头 DataLen 字段，截断负载被静默解析成错误值，奇数长度字负载抛裸 struct.error", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "parse_write_response 不校验 D000 响应子头，任何 EndCode=0 的帧（含被误路由的请求回显）都判为写入成功，与 parse_read_response 不对称", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "is_bit_device 与 README 声明 S/V/F/Z/ZR/R/SW 受支持，但 DEVICE_CODES 未收录，read_device('S0') 等直接抛 MCFrameError，文档功能不可用", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "write_device 失败路径 safety_validator.consecutive_errors += 1 在 validator 锁外自增，可被并发成功 validate() 的清零覆盖，熔断计数不可靠", "severity": "LOW" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "read_device/write_device 用裸 except Exception 捕获所有异常并把 str(e) 原样回传客户端，泄露连接端点与协议内部细节，同时吞掉编程错误、丢失异常类型与堆栈", "severity": "HIGH" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "get_connection 缓存的全局 TCP 连接在失败后从不重置/重连（except 分支不清 _reader/_writer），一次会话中断后所有后续读写永久失败", "severity": "HIGH" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "build_write_request 对字设备写入 value & 0xFFFF 静默截断、负值回绕，write_device 无 16 位范围校验，超范围值被静默写成错误数据却返回成功", "severity": "HIGH" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "parse_read_response/parse_write_response 从不使用响应头 DataLen 字段，server.py 用 r.read(1024) 单次读帧；TCP 半包时读路径解析错乱、写路径可能已写入却误报失败并累加熔断计数", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "parse_write_response 不像读路径那样校验响应子头 0xD000，任意 EndCode==0 的错位/残留帧都会被判为写入成功", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "设备编号用 struct.pack('<I', offset)[:3] 编码且无上限校验，offset>0xFFFFFF 静默截断会落到错误设备；read 的 count 也无上限", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "asyncio.open_connection 无连接超时（读有 wait_for 5s，建连没有），连接挂起时永久阻塞；并发首连存在竞态，后写覆盖先写导致 socket 泄漏", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "parse_read_response 对 data_len==2 的合法空响应返回 []（test_parse_empty 固化），随后 values[0] 抛 IndexError 被泛化 except 吞掉，以裸 Python 异常文本回传", "severity": "LOW" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "read_devices 在列表推导中逐地址串行 await read_device()，每地址独立请求帧（count=1）、独立认证与审计、各等一个完整 RTT，是典型 N+1；协议已支持批量读（build_read_request 的 count 参数 / parse_read_response 多点解析），一帧即可完成", "severity": "HIGH" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "read_device/write_device 使用单次 r.read(1024) 而非按帧 DataLen 精确读取；TCP 分包导致读到半帧时误报‘响应过短’且无重试，客户端只能重发造成重复往返，1024 上限也限制批量读", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "async 工具处理器内调用同步阻塞的 audit.log()（mcp_common/audit.py _write_entry：跨进程文件锁 + 读取最多 64KB 日志尾 + 写盘 flush），write_device 单次请求最多触发 4 次，直接阻塞 asyncio 事件循环", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "get_connection 无断线重连：TCP 连接失效后 _reader/_writer 仍非 None，每次后续调用都空等 asyncio.wait_for 满 5s 超时后失败，反复阻塞 5s", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "build_read_request/build_write_request 每次构建对同一地址字符串解析两次：_parse_device(addr)（re.match 全量正则）后 is_bit_device(addr) 再走 _device_prefix(addr)（再次正则+rstrip），冗余重复计算", "severity": "LOW" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "parse_read_response 逐元素解包：字路径循环里逐点 struct.unpack('<H', payload[i:i+2])，位路径逐点计算 i//2、i%2；批量读多点时可一次 struct.unpack('<NH', ...) 及逐字节移位，O(n) 慢解包", "severity": "LOW" },
#{ "file": "mcp_common/config.py", "issue": "Config.__getattr__ 每次属性访问都对字符串值重跑 _resolve_env（re.sub 正则替换）与 _looks_like_path（正则），server.py 的 get_connection/_confirmation_device_id 每次调用都重复触发，可缓存解析结果", "severity": "LOW" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "write_device 的安全校验对三菱地址完全空转：safety.validator 的 FORBIDDEN_PATTERNS/CONFIRM_PATTERNS 与 interlock-rules.yml 规则全部是 S7 标签名（DB1.*、ESTOP/MOTOR/PUMP 等）模式，三菱设备地址（M100/Y20/D200/S0/L50…）永不匹配，validate() 恒返回 allowed=True 且 needs_confirmation=False。因此对直接驱动执行机构的物理输出 Y、锁存继电器 L、步进继电器 S、特殊继电器等任意地址写入均无互锁、无 max/min/cooldown、无需人工确认，形成无护栏直写通道。", "severity": "CRITICAL" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "'影子检查'是伪安全：shadow_sim.simulate_write 调用从不传入 current_value，也从不读取 PLC 当前值，仅基于本进程内存中的写历史做变化率检测，首次写入任何地址恒通过；且其 forbidden 模式同样匹配不上三菱地址。sim_result.safe 对三菱地址基本恒为 True，不构成任何实质前置检查。", "severity": "HIGH" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "地址解析与写入帧构建无设备类型可写性/地址范围限制：_parse_device 接受任意 3 字节 offset（最大 0xFFFFFF）且不校验设备类型是否可写（X 输入、系统/特殊继电器、保留地址区均可编码），build_write_request 直接打包发送。结合 server.py 无护栏校验，可对任意物理输出/系统地址发起写请求。", "severity": "HIGH" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "认证与审计身份缺陷：_require_auth 用普通 '!=' 比较 token（非常数时间，存在时序侧信道）；所有调用方共享单一静态 MCP_AUTH_TOKEN，authenticated_actor 对持有者产生的指纹完全相同，审计无法区分真实操作者，双人确认机制所需的 operator/approver 区分也随共享令牌失效。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "熔断机制可被绕过：写异常路径直接执行 safety_validator.consecutive_errors += 1（不经 WriteValidator 内部 RLock，绕过其锁语义），而每次 validate() 成功即把计数器清零，攻击者以成功/失败交替操作即可不断重置熔断，连续异常强制人工介入的保障失效。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "人工确认的审计闭环缺失：confirmation_service.consume() 返回的 payload（含 approver 身份与 audit_id）被丢弃，审计日志只记录 operator=actor（共享令牌指纹），批准本次写入的人工确认者身份不可追溯，违反'确认令牌绑定审计链'的要求；且本模块无令牌签发入口，确认路径与 MCP 直连调用脱节。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/mitsubishi-mcp/mc_protocol.py", "issue": "响应解析健壮性不足：parse_write_response 不校验响应 subheader（任何 end_code=0 的响应帧均判定写入成功）；parse_read_response 不校验 DataLen 字段与实际 payload 长度一致性；server 端单次 r.read(1024) 读取，TCP 半包/粘包时可能解析出错误值或对未真正完成的写入误报成功。", "severity": "LOW" },
#{ "file": "mcp-servers/mitsubishi-mcp/server.py", "issue": "read_devices 无地址列表长度与调用频率限制，顺序复用同一连接逐条读取任意地址（仅需共享 token），可被用于未授权地址空间探测；读取路径审计 operator 固定为默认值，无法追溯真实请求者。", "severity": "LOW" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "所有工具均为 async def，却在 asyncio 事件循环内直接调用阻塞式 pymodbus 同步方法（无 to_thread 卸载）。设备无响应时每次调用阻塞约 3s×4 次重试；scan_devices 顺序探测 1..10 号从站、每个无响应从站约 12s，最坏可冻结整个 MCP 服务器约 2 分钟，期间所有其他工具被阻塞（pymodbus 3.13 sync_execute 重试逻辑 + 默认 timeout=3/retries=3）。", "severity": "HIGH" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "write_register 不校验 Modbus 16 位范围 0..65535、write_coil/读地址不校验 0..65535 与非负。越界值/负数地址可同时通过 safety validator（±1e6）和 shadow_sim 检查，并在 consume 消费一次性人工确认令牌之后，才在 pymodbus 编码层抛 struct.error/ValueError——注定失败的写入也会永久烧掉一份人工确认，且没有任何预校验或令牌补偿路径。", "severity": "HIGH" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "scan_devices 用 except Exception: pass 吞掉所有异常：PLC 完全不可达时返回 []，与“无设备在线”无法区分；对在线但返回异常响应（如无寄存器 0）的设备也静默判为离线，且每个无响应从站触发完整超时+重连，无任何错误信号。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "读失败被伪装为成功空值：设备返回 Modbus 异常响应时 read_coil/read_discrete_input 返回 {\"value\": None}、read_register 返回 {\"values\": None}（无 error 字段）；而超时抛异常时返回 {\"error\": ...}。同一 API 两种失败模式，调用方无法区分“读失败”与“值本身为空”。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "两个写工具 except 分支直接执行 safety_validator.consecutive_errors += 1，而 WriteValidator._lock 只在 validate() 内持有（safety/validator.py:178）；这是共享熔断状态上的非原子读-改-写，并发下计数丢失、熔断语义被削弱。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "get_client() 懒初始化无锁（if _client is None 竞态，并发首调可创建两个 ModbusTcpClient、泄漏一个），且 _client.connect() 返回值被丢弃——连接失败后仍返回未连接客户端，且模块内无任何 close/重建路径。", "severity": "LOW" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "读路径的 except 分支不调用 audit.log：audit 只在 rr.isError() 分支记录；get_client() 或读操作抛异常导致的读失败在 HMAC 审计链中完全不可见，审计完整性缺口。", "severity": "LOW" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "_require_auth 使用普通字符串比较 token != _AUTH_TOKEN，非恒定时间比较，存在认证令牌时序侧信道；应使用 hmac.compare_digest。", "severity": "LOW" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "scan_devices 中 `except Exception: pass`（L231-232）盲目吞掉所有异常：连接失败/Modbus 错误/端口类型错误均无审计记录，失败时返回 []，与'无设备在线'无法区分，工具调用仍被报告为成功", "severity": "HIGH" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "读取工具（L67-68/80-81/95-96）与写入工具（L158-161/216-219）用宽泛 `except Exception as e` 把 `str(e)` 原样返回给调用方，原始异常文本可能泄露连接目标 host/port 与 pymodbus 内部信息，且失败仍返回成功状 dict", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "读取路径异常不写审计（audit.log 仅在成功路径 L64/78/92），连接超时/断线在审计链中不可见；且读侧失败不会触发 consecutive_errors 熔断，熔断只在写路径 +1", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "get_client()（L42-47）忽略 connect() 的布尔返回值并永久缓存 _client，连接失败或断线后从不重连、不检查 connected 属性（mcp_common/connection.py 提供 reset() 但未使用），断线后所有读写退化为被吞掉的通用错误", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "settings.modbus_port 为 env_config() 返回的字符串（默认 '502'），直接传给 ModbusTcpClient(port=...) 不转 int；pymodbus CommParams 为 dataclass 不强制类型，socket.create_connection((host,'502')) 抛 TypeError 且 connect() 只捕获 OSError，导致所有 Modbus 操作静默失败并被宽泛 except 掩盖（对照 edge-gateway L211 的 port=int()）", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "写路径（L148-161）中 begin_control_operation/物理写入/成功审计 audit.log 在同一 try：写入成功后 audit.log 若抛 AuditStorageError，except 处理器内 audit.log 再次抛异常导致未捕获传播、consecutive_errors 不 +1，调用方收到异常可能重试造成重复写入，审计链只有 control_intent 无完成记录", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "Modbus 错误帧（rr.isError()）时读取返回 {'value': null}/{values: null}（L63/77/91），无 status/error 标记，调用方无法区分读取失败与合法空数据，失败路径被当作正常返回", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "_require_auth（L36-37）向未认证调用者返回 'MCP_AUTH_TOKEN 未配置，服务不可用'，泄露服务器认证配置状态，便于探测", "severity": "LOW" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "所有 async def 工具（read_coil/read_register/read_discrete_input/write_coil/write_register/scan_devices）直接在 asyncio 事件循环上执行同步阻塞的 pymodbus TCP 调用（read_coils/read_holding_registers/read_discrete_inputs/write_coil/write_register/connect），无 to_thread/run_in_executor 卸载。设备无响应时单次调用可阻塞整个 MCP 服务数秒（pymodbus 默认 timeout≈3s×retries=3），影响所有并发请求。", "severity": "HIGH" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "scan_devices 对 slave_id 1..10 串行执行 10 次 count=1 单寄存器读取（N+1 式顺序扫描），无并发、无单次超时上限，except Exception: pass 吞掉所有错误；离线从站每次吃满 TCP 超时，单次扫描可阻塞事件循环达 ~10×(timeout×retries) 秒，最终只返回空列表；get_client() 还在循环体内重复调用。", "severity": "HIGH" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "每次读操作都调用 audit.log()（mcp_common/audit.py _write_entry）：同步执行 _ensure_storage_writable 打开+flush、_InterProcessLock 阻塞式 msvcrt.locking(LK_LOCK) 跨进程锁、_load_last_hash 重读文件尾 64KB 并解析，再追加+flush+解锁+关闭。每次线圈/寄存器读取都在事件循环上完成整条链式审计 I/O，且进程内存已有 prev_hash 仍每次重读文件。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "get_client() 仅当 _client is None 时 connect() 一次，缓存客户端永不重连；连接断开后陈旧客户端被永久复用，之后每个请求都阻塞等待 socket 超时并失败直到进程重启，无存活检查/重连/连接超时上限。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "写路径对同一 tag/value 重复执行两遍重叠校验：safety_validator.validate()（validator.py 检查 FORBIDDEN_PATTERNS、>1_000_000 范围、跳变率）之后又调用 shadow_sim.simulate_write()（shadow_simulator.py 对同一批 FORBIDDEN_PATTERNS、同一 1_000_000 边界、同一变化率重复检查），同一组正则扫描与 float 转换每次写入都算两遍。", "severity": "LOW" },
#{ "file": "safety/shadow_simulator.py", "issue": "simulate_write() 第 142-144 行对每次写入无条件 await asyncio.sleep(0.01)（注释自认并非真正仿真），仅为每次写入增加固定 10ms 人工延迟，无实际作用。", "severity": "LOW" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "read_coil 与 read_discrete_input 签名仅接收单个 address，内部硬编码 count=1，无批量读取工具（read_register 才有 count 参数）；读取 N 个线圈/输入点需 N 次 MCP 调用 = N 次独立 Modbus 往返，构成 API 层 N+1 模式且每次往返都在事件循环上阻塞。", "severity": "LOW" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "安全链对 Modbus 结构性失效：写工具 tag 构造为 coil.{address}/register.{address}，永远无法命中 safety/validator.py 的 FORBIDDEN_PATTERNS（ESTOP/SAFETY/EMERGENCY）、CONFIRM_PATTERNS（MOTOR/PUMP/VALVE 等）与 interlock-rules.yml 的 write_rules（target 全是 DB1.* S7 符号名）；shadow_simulator._check_forbidden 同样只按名称匹配。因此任何已认证调用者可直接写任意线圈/寄存器（含接线到急停或安全回路的地址），既无人工确认也无互锁检查，与模块声称的『带安全校验』相反。", "severity": "CRITICAL" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "写入路径缺少 Modbus 协议级输入校验：address 未校验（允许负数/超 65535 未拒绝、无 0..65535 范围检查、无地址白名单），read_register 的 count 无上限；write_coil 的 bool 值完全跳过数值范围检查（validator 对 bool 的 isinstance 判断直接跳过），write_register 仅靠全局 ±1,000,000 兜底，可寻址到非预期寄存器。", "severity": "HIGH" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "写入后无读回验证，异常分支（如超时）一律返回 status:error，但写入可能已在设备端生效；同时 except 分支对全局熔断计数器 safety_validator.consecutive_errors 无锁自增，且 post-write 的 audit.log 失败被 except 吞掉，控制动作的完成审计可能静默缺失。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "所有工具共享同一个全局 ModbusTcpClient（get_client 惰性单例），FastMCP 异步工具处理并发调用时无锁/无排队保护，同步 pymodbus 客户端在 async 上下文的并发读写可能交错帧，导致协议状态损坏或写到错误地址/单元。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "认证令牌以明文工具参数 auth_token 形式在每次调用中传递（且无速率限制），对 MCP 客户端与工具调用记录可见，存在令牌经日志/会话记录泄露及无限暴力尝试面；仅依赖环境变量 MCP_AUTH_TOKEN 的静态值。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "_require_auth 使用普通字符串比较 token != _AUTH_TOKEN（非恒定时间比较，未用 hmac.compare_digest），存在计时侧信道放大暴力破解的风险。", "severity": "LOW" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "各工具 except 分支直接返回 str(e) 原始异常文本给调用方（如 read_coil/read_register/write_*），可能泄露主机地址、端口、栈细节等内部信息。", "severity": "LOW" },
#{ "file": "mcp-servers/modbus-mcp/server.py", "issue": "write_coil/write_register 的 operator 工具参数被接受并声明为默认 ai-agent，但代码从未校验或使用它（审计主体实际取自令牌指纹），给调用者造成『身份已绑定 operator』的错误印象，且审计中的 operator 字段可被伪造的语义掩盖真实身份。", "severity": "LOW" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "快捷键黑名单仅做精确元组匹配，可被按键顺序重排（如 [alt,ctrl,del]）或别名（如 windows 代替 win、ctrl 代替…）绕过，pyautogui.hotkey 仍会触发 Ctrl+Alt+Del/Win+L/Alt+F4 等被禁组合键，安全控制失效", "severity": "HIGH" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "tool_drag 直接用 pyautogui.drag(x2-x1, y2-y1) 从当前光标位置按偏移量拖拽，从未先 moveTo(x1,y1)，与文档'从(x1,y1)拖到(x2,y2)'不符，拖拽起点错误可能误抓放对象", "severity": "MEDIUM" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "req[\"params\"][\"name\"]、_require_auth(args)、mcp_recv 的 json.loads、热键 normalize 中 k.lower() 均在 try/except 与主循环保护之外，缺 params/name、arguments 非 dict、非字符串按键、空行或非 JSON 输入都会让未捕获异常终止整个服务器进程", "severity": "MEDIUM" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "tool_type_text 用 pyautogui.write 输入文本，对未映射物理按键的字符（中文、emoji 等 Unicode）必然抛 KeyError，中文语境下工具实际不可用", "severity": "MEDIUM" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "clicks/interval/presses/confidence/region 等参数无运行时类型校验，客户端以字符串传入时 pyautogui 抛 TypeError，错误信息不明确", "severity": "LOW" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "tool_double_click/tool_right_click 在仅提供 x 或 y 单坐标时静默回退到当前光标位置执行点击，可能误操作", "severity": "LOW" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "认证令牌用非恒时 != 比较且随每次工具调用 arguments 明文传递，存在时序侧信道与令牌进入日志/审计链的风险", "severity": "LOW" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "mcp_recv() 对 json.loads(line) 无异常处理，单行非法 JSON 即抛 JSONDecodeError 杀死整个主循环，且不回送 JSON-RPC parse error 响应", "severity": "HIGH" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "handle_tool_call 中 req['params']['name'] 及认证检查位于 try 块之外，params/name 缺失或非 dict 时 KeyError/AttributeError 直接使进程崩溃", "severity": "HIGH" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "兜底 except 将 str(e) 原文作为错误消息回传客户端，可能泄露绝对路径、库内部细节及 type_text 回显的输入内容", "severity": "MEDIUM" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "tool_locate_on_screen 将异常转换为 result 中的 {\"error\": str(e)}，协议层显示成功，失败不可区分；FileNotFoundError 文本泄露 image_path 路径", "severity": "MEDIUM" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "MCP_AUTH_TOKEN 未设置时 _require_auth 直接放行，可截屏并控制鼠标键盘的桌面控制服务默认零认证；令牌比较非恒定时间存在计时侧信道", "severity": "MEDIUM" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "主循环对未知方法（含标准 MCP initialize 握手）静默丢弃，无错误响应，客户端握手将挂起超时", "severity": "LOW" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "mcp_send 对 stdout 管道写入无异常处理，客户端断开时 BrokenPipeError 使服务崩溃且无优雅退出", "severity": "LOW" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "move_mouse/type_text/drag 用 args['x'] 等下标直接访问且无输入校验，缺参时以原始 KeyError 文本返回，无结构化错误", "severity": "LOW" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "所有 async def 工具处理函数内无任何 await，直接在事件循环内同步执行阻塞的 pyautogui 调用，且 mcp_recv() 用阻塞式 sys.stdin.readline()；请求严格串行，长耗时调用（type_text/screenshot/drag）期间 tools/list、shutdown 等全部排队且无法中断，未使用 asyncio.to_thread/run_in_executor 卸载阻塞。", "severity": "HIGH" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "第 75 行 pyautogui.PAUSE=0.5 使每个 pyautogui 调用结束后额外 sleep 0.5s，每个工具调用至少附加 0.5s 固定延迟，多步操作线性累加。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "tools/list 处理器（497-502 行）对每次请求都重新 json.dumps 静态 tools 列表，而该列表已在启动时构建（329-484 行），属无意义重复计算，可预序列化复用。", "severity": "LOW" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "tool_locate_on_screen（279 行）每次调用都全屏截图并做模板匹配，且不支持 region 参数（对比 tool_screenshot 支持 region）；在定位-点击-再定位轮询中每轮重复全屏抓取与匹配，缺少区域裁剪/结果复用。", "severity": "LOW" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "认证失败开放（fail-open）：_require_auth 在环境变量 MCP_AUTH_TOKEN 未设置时直接返回 None 放行全部工具调用，且无任何告警或硬失败；结合 13 个可控制鼠标/键盘/截屏的工具，默认启动即完全无认证地暴露桌面控制与屏幕数据外泄能力。", "severity": "CRITICAL" },
#{ "file": "orchestrator/server_configs.py", "issue": "DESKTOP_MCP 注册项（第 79-84 行）未配置 credential_envs=(\"MCP_AUTH_TOKEN\",)，与 MITSUBISHI_MCP、ROBOT_MCP 不同，导致经 orchestrator 标准启动路径运行时认证令牌永不被注入，认证形同虚设，属控制边界被静默绕过。", "severity": "HIGH" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "危险操作缺少确认：type_text 可向任意焦点窗口输入任意文本，press_key 的 'enter' 未列入黑名单，二者组合可注入并执行 shell 命令；click/drag/hotkey/type_text 等控制动作全程无人工确认或互锁机制，唯一防护是覆盖面很小的黑名单。", "severity": "HIGH" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "快捷键黑名单可绕过：_is_blacklisted_hotkey 仅对归一化后的完整按键元组做精确匹配，调用方给危险组合附加任意键（如 [\"win\",\"r\",\"shift\"] 或 [\"ctrl\",\"alt\",\"shift\",\"delete\"]）即可绕过拦截，pyautogui.hotkey 仍会触发原危险组合。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "tool_locate_on_screen 接受调用方传入的任意 image_path 并直接交给 pyautogui.locateOnScreen 读取，构成任意本地文件读取/存在性探测原语；配合未认证状态可被用于探测与读取本机文件，且异常 str(e) 会泄露文件系统信息。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "无审计链：整个服务器没有任何操作审计记录（对比 opcua-mcp 有 opcua_audit.log、tia-mcp 有 audit.py），截屏、键盘、鼠标等全部控制动作不留痕，违反工作区要求的审计链/可追溯边界。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "令牌比对使用普通不等号（token != _AUTH_TOKEN）而非 hmac.compare_digest 常数时间比较，存在时序侧信道风险。", "severity": "LOW" },
#{ "file": "mcp-servers/desktop-mcp/server.py", "issue": "mcp_recv 对 stdin 行直接 json.loads 且无异常处理，客户端发送畸形 JSON 即抛出异常导致主循环崩溃退出（本地 DoS）；同时所有工具 inputSchema 均未声明 auth_token 属性，与 _require_auth 从 arguments 读取令牌的契约不一致。", "severity": "LOW" },
#{ "file": "mcp-servers/robot-mcp/pnp_fc.scl", "issue": "急停释放后、等待复位(bRunEnabled=FALSE)分支未继续强制 Q0_0-Q0_4 为 FALSE，而 robot-mcp 的 _estop_reset_required 只在故障期间发起动作写入时才置位；急停短时抖动即恢复时，robot-mcp 软件门禁放行、PLC 侧又不清除输出，复位未按下时机械臂/传送带仍可被驱动，安全互锁存在窗口。", "severity": "HIGH" },
#{ "file": "mcp-servers/robot-mcp/server.py", "issue": "IO_MAP 的 OPC UA 节点路径使用点号标签名(I0.0/I0.8/Q0.0)，而本模块部署的 pnp_tags.json 与 pnp_fc.scl 使用下划线标签名(I0_0/I0_8/Q0_0)；按标准部署流程标签名无法解析为这些节点，OPC UA 后端所有读返回 None、estop 被视为未知、动作被 fail-closed 拒绝，首选后端实际失效。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/robot-mcp/server.py", "issue": "snap7 输出写是 read-modify-write(先 read_area 再改位再 write_area)，非原子；FastMCP 并发调用时对同一输出字节的并发写(如 conveyor_entry 与 conveyor_exit)会相互覆盖丢位，存在 TOCTOU 竞态。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/robot-mcp/server.py", "issue": "pick_item 的 Z上升/X收回、place_item 的全部移动步骤、move_arm_to 的全部移动步骤忽略 wait_for 返回值，到位超时仍返回 status=ok 并声称已到位/已回位，实际机械臂位置不可信。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/robot-mcp/deploy_pnp.py", "issue": "step6_robot 启动 server.py 时未传 --auth-token 且未确保 MCP_AUTH_TOKEN 环境变量存在；环境无该变量时 _require_auth 对全部工具抛 PermissionError，部署脚本报告成功但服务器对所有命令不可用。", "severity": "MEDIUM" },
#{ "file": "mcp-servers/robot-mcp/server.py", "issue": "模拟模式下急停门禁不拦截 sensor_estop 写入(agent 可自行置健康)，且 _update_sim_dependencies 使 sensor_item_detected 完全由 grab 决定(抓取永不失败)，离线'测试通过'与真实互锁/传感无对应关系。", "severity": "LOW" },
#{ "file": "mcp-servers/robot-mcp/server.py", "issue": "ensure_connected 自动模式仅凭 _opc_client is not None 判断已连接，不检测连接活性、不重连、不回退 snap7，OPC UA 掉线后读写静默失败；connect_snap7 为同步阻塞调用且在 async 路径直接返回，连接超时期间卡死事件循环。", "severity": "LOW" },
#{ "file": "mcp-servers/robot-mcp/server.py", "issue": "run_pick_cycle 的 cycles_completed 按成功步骤数统计(一次 pick+place 都成功计为 2)，而非循环次数，返回的完成数与语义不符。", "severity": "LOW" },
#{ "file": "mcp-servers/robot-mcp/server.py", "issue": "异常分支丢弃 _safe_go_home() 的返回结果并无条件返回“已复位”；且 _safe_go_home 内 write_io 不抛异常，即使全部写入失败也返回 ok，通信故障时会谎报安全回位成功（行383-393、542-543、596-597、661-662、691-692）", "severity": "HIGH" },
#{ "file": "mcp-servers/robot-mcp/server.py", "issue": "read_io 用 except Exception: return None 吞掉所有异常，通信故障与信号为假不可区分；pick_item 中 None 会误触发送料分支（行238-240、494-509），write_io 错误 dict 在各调用点被忽略", "severity": "HIGH" },
#{ "file": "mcp-servers/robot-mcp/server.py", "issue": "write_io、get_status 及全部 MCP 工具将原始 str(e) 直接拼入返回给客户端的错误消息，可能泄露内部端点/连接细节（行282、411-414、470、543、597、662、692、723）", "severity": "MEDIUM" },
#{ "file": "mcp-servers/robot-mcp/server.py", "issue": "connect_opcua/connect_snap7 静默吞掉连接异常（except Exception: pass），失败原因无日志，auto 模式双后端失败时仅剩通用提示，无法排查（行145-166）", "severity": "MEDIUM" },
