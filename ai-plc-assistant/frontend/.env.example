# AI PLC Assistant Frontend — 环境变量示例
#
# 复制此文件为 .env.local（个人开发）或 .env.production（生产构建）并修改。
#
# Vite 仅暴露 VITE_ 前缀的变量到客户端代码。
# 切勿在此文件提交真实 Token。

# API 基础地址
# - dev 模式默认 '/api'（走 Vite proxy 到 http://127.0.0.1:8005）
# - 生产模式默认 'http://127.0.0.1:8005/api'（Electron 同机）
# - Web 部署时改为后端实际地址，如 'https://api.example.com/api'
VITE_API_BASE=/api

# API 文档地址（用于 window.open）
# - 默认从 VITE_API_BASE 推导（去掉 /api 后缀 + /docs）
# - 特殊情况可显式指定
# VITE_API_DOCS_URL=https://api.example.com/docs

# 本地 API Token（可选，用于本地控制接口鉴权）
# 仅在本地开发环境使用，生产 Web 部署不应注入此变量（Token 会出现在 JS bundle）
# VITE_LOCAL_API_TOKEN=

# 应用模式标识（仅用于日志和调试）
# - web：浏览器模式
# - electron：桌面模式（自动检测，无需手动配置）
VITE_APP_MODE=web
