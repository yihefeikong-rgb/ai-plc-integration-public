# ============================================
# AI 接入 PLC — 环境变量模板
# 复制为 .env 并填入真实值
# ============================================
# ⚠️  警告：.env 文件包含敏感凭据，禁止提交到 Git！
#    运行 git check-ignore .env 确认文件已被忽略
# ============================================

# DeepSeek API（必填）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# TIA Portal 项目路径（仅 Windows 工程站需要）
# V21 项目示例:
TIA_PROJECT_PATH=D:\PLC cheng xu\TIA PLC CHENG XU\demo_V21\demo_V21.ap21
# TIA Portal 安装目录
TIA_INSTALL_DIR=D:\TIA BEN TI\Portal V21
# 仿真/输出文件目录
TIA_OUTPUT_DIR=D:\TIA FANG ZHEN

# PLCSIM Advanced
PLCSIM_BACKEND=advanced
PLCSIM_ADV_DIR=D:\TIA FANG ZHEN\PLCSIMADV
PLCSIM_TARGET_IP=192.168.0.1
TIA_DEVICE_NAME=S7-1500/ET200MP station_1

# Golden Backup（PLCSIM 实例存档路径）
GOLDEN_V18_DIR=D:\PLC cheng xu\TIA PLC CHENG XU\demo
GOLDEN_V21_DIR=D:\PLC cheng xu\TIA PLC CHENG XU\demo_V21
GOLDEN_ZIP_PATH=D:\PLC cheng xu\TIA PLC CHENG XU\demo\factory_io1_golden.zip
GOLDEN_STORAGE_PATH=D:\PLC cheng xu\TIA PLC CHENG XU\demo\plcsim_storage

# Factory I/O
FACTORY_IO_DIR=D:\Factory IO
FIO_DRIVER_MODE=plcsim
FIO_TCP_HOST=192.168.0.1
# Factory I/O 场景文件路径
FIO_SCENE_PATH=C:\Users\xxx\Documents\Factory IO\My Scenes\测试.factoryio

# InfluxDB（时序数据库，默认账号 admin）
INFLUXDB_PASSWORD=your-strong-password
INFLUXDB_TOKEN=your-influxdb-token

# OPC UA（西门子 PLC）
OPCUA_ENDPOINT=opc.tcp://192.168.1.10:4840
OPCUA_USERNAME=
OPCUA_PASSWORD=

# Modbus（仿真 / 备选）
MODBUS_HOST=localhost
MODBUS_PORT=502

# 三菱 MELSEC PLC（MC 协议）
MELSEC_HOST=
MELSEC_PORT=5001

# S7 协议（西门子 PLC 运行态通信，通过 python-snap7）
S7_PLC_IP=192.168.0.1
S7_RACK=0
S7_SLOT=1
