# ============================================
# AI 接入 PLC — 环境变量模板
# 复制为 .env 并填入真实值
# ============================================

# DeepSeek API（必填）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# TIA Portal 项目路径（仅 Windows 工程站需要）
TIA_PROJECT_PATH=D:\path\to\your\project.ap18

# InfluxDB（时序数据库，默认账号 admin）
INFLUXDB_PASSWORD=your-strong-password
INFLUXDB_TOKEN=your-influxdb-token

# OPC UA（西门子 PLC）
OPCUA_ENDPOINT=opc.tcp://192.168.1.10:4840
OPCUA_USERNAME=
OPCUA_PASSWORD=

# Modbus（仿真 / 备选）
MODBUS_HOST=localhost
MODBUS_PORT=502

# 三菱 MELSEC PLC（MC 协议）
MELSEC_HOST=
MELSEC_PORT=5001
