<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\</OutputPath>
    <!-- 默认 V18，可通过 -p:TiaVersion=V21 切换到 V21 -->
    <TiaVersion Condition="'$(TiaVersion)' == ''">V18</TiaVersion>
  </PropertyGroup>

  <!-- Openness API 要求：引用的 Siemens DLL 不能存在于输出目录 -->
  <Target Name="CleanSiemensDlls" AfterTargets="Build">
    <ItemGroup>
      <SiemensFilesToDelete Include="$(OutputPath)Siemens.Engineering*.dll" />
      <SiemensFilesToDelete Include="$(OutputPath)Siemens.Engineering*.pdb" />
    </ItemGroup>
    <Delete Files="@(SiemensFilesToDelete)" />
  </Target>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- V18 引用（单体 DLL） -->
  <ItemGroup Condition="'$(TiaVersion)' != 'V21'">
    <Reference Include="Siemens.Engineering">
      <HintPath>D:\TIA BEN TI\Portal V18\PublicAPI\V18\Siemens.Engineering.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- V21 引用（模块化 DLL） -->
  <ItemGroup Condition="'$(TiaVersion)' == 'V21'">
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>D:\TIA BEN TI\Portal V21\PublicAPI\V21\net48\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>D:\TIA BEN TI\Portal V21\PublicAPI\V21\net48\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
