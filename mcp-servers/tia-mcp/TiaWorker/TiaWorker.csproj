<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\</OutputPath>
    <!-- 本项目仅支持唯一的 V21 隔离目标；安装目录可由构建环境覆盖。 -->
    <TiaVersion Condition="'$(TiaVersion)' == ''">V21</TiaVersion>
    <TiaInstallDir Condition="'$(TiaInstallDir)' == ''">D:\TIA BEN TI\Portal V21</TiaInstallDir>
  </PropertyGroup>

  <!-- Openness API 要求：引用的 Siemens DLL 不能存在于输出目录 -->
  <Target Name="CleanSiemensDlls" AfterTargets="Build">
    <ItemGroup>
      <SiemensFilesToDelete Include="$(OutputPath)Siemens.Engineering*.dll" />
      <SiemensFilesToDelete Include="$(OutputPath)Siemens.Engineering*.pdb" />
    </ItemGroup>
    <Delete Files="@(SiemensFilesToDelete)" />
  </Target>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <Target Name="ValidateTargetVersion" BeforeTargets="ResolveReferences">
    <Error Condition="'$(TiaVersion)' != 'V21'" Text="TiaWorker 仅支持 V21；请与 config.yaml 的 target.tia_version 保持一致。" />
  </Target>

  <!-- V21 引用（模块化 DLL） -->
  <ItemGroup>
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(TiaInstallDir)\PublicAPI\V21\net48\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>$(TiaInstallDir)\PublicAPI\V21\net48\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
