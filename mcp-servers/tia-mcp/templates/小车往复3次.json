{
  "blockName": "AutoCart3Cycle",
  "blockNumber": 1,
  "interface": {
    "inputs": [
      {
        "name": "bStart",
        "type": "Bool",
        "comment": "启动",
        "address": "%I7.0"
      },
      {
        "name": "bStop",
        "type": "Bool",
        "comment": "停止",
        "address": "%I7.1"
      },
      {
        "name": "bReset",
        "type": "Bool",
        "comment": "复位",
        "address": "%I7.2"
      },
      {
        "name": "bEmergencyStop",
        "type": "Bool",
        "comment": "急停（常闭）",
        "address": "%I7.3"
      },
      {
        "name": "bForwardLimit",
        "type": "Bool",
        "comment": "前限位",
        "address": "%I7.4"
      },
      {
        "name": "bReverseLimit",
        "type": "Bool",
        "comment": "后限位",
        "address": "%I7.5"
      },
      {
        "name": "bOverload",
        "type": "Bool",
        "comment": "过载（常闭）",
        "address": "%I7.6"
      }
    ],
    "outputs": [
      {
        "name": "bForwardOut",
        "type": "Bool",
        "comment": "正转输出",
        "address": "%Q7.0"
      },
      {
        "name": "bReverseOut",
        "type": "Bool",
        "comment": "反转输出",
        "address": "%Q7.1"
      },
      {
        "name": "bRunning",
        "type": "Bool",
        "comment": "运行中",
        "address": "%Q7.2"
      },
      {
        "name": "bFault",
        "type": "Bool",
        "comment": "故障指示",
        "address": "%Q7.3"
      }
    ],
    "local": [
      {
        "name": "bSafetyOK",
        "type": "Bool",
        "comment": "安全状态"
      },
      {
        "name": "bFaultLatch",
        "type": "Bool",
        "comment": "故障锁存"
      },
      {
        "name": "bStateFwd",
        "type": "Bool",
        "comment": "前进状态"
      },
      {
        "name": "bStateUnload",
        "type": "Bool",
        "comment": "卸载状态"
      },
      {
        "name": "bStateRev",
        "type": "Bool",
        "comment": "后退状态"
      },
      {
        "name": "bStateLoad",
        "type": "Bool",
        "comment": "装载状态"
      },
      {
        "name": "bCycleDone",
        "type": "Bool",
        "comment": "循环完成"
      }
    ]
  },
  "networks": [
    {
      "title": "急停互锁",
      "comment": "急停和过载都正常时才允许运行",
      "elements": [
        {
          "type": "normally_closed",
          "operand": "bEmergencyStop"
        },
        {
          "type": "normally_closed",
          "operand": "bOverload"
        },
        {
          "type": "coil",
          "operand": "bSafetyOK"
        }
      ]
    },
    {
      "title": "故障锁存",
      "comment": "安全链断开时锁存故障",
      "elements": [
        {
          "type": "normally_closed",
          "operand": "bSafetyOK"
        },
        {
          "type": "coil_set",
          "operand": "bFaultLatch"
        }
      ]
    },
    {
      "title": "故障复位",
      "comment": "复位按钮清除故障锁存",
      "elements": [
        {
          "type": "normally_open",
          "operand": "bReset"
        },
        {
          "type": "normally_open",
          "operand": "bFaultLatch"
        },
        {
          "type": "coil_reset",
          "operand": "bFaultLatch"
        }
      ]
    },
    {
      "title": "启动前进 Set",
      "comment": "启动前进状态",
      "elements": [
        {
          "type": "normally_open",
          "operand": "bStart"
        },
        {
          "type": "normally_closed",
          "operand": "bFaultLatch"
        },
        {
          "type": "normally_closed",
          "operand": "bCycleDone"
        },
        {
          "type": "coil_set",
          "operand": "bStateFwd"
        }
      ]
    },
    {
      "title": "前进输出",
      "comment": "前进状态驱动电机正转",
      "elements": [
        {
          "type": "normally_open",
          "operand": "bStateFwd"
        },
        {
          "type": "coil",
          "operand": "bForwardOut"
        },
        {
          "type": "coil",
          "operand": "bRunning"
        }
      ]
    },
    {
      "title": "前限位转卸载",
      "comment": "到前限位后清除前进状态、设置卸载状态",
      "elements": [
        {
          "type": "normally_open",
          "operand": "bStateFwd"
        },
        {
          "type": "normally_open",
          "operand": "bForwardLimit"
        },
        {
          "type": "coil_reset",
          "operand": "bStateFwd"
        },
        {
          "type": "coil_set",
          "operand": "bStateUnload"
        }
      ]
    },
    {
      "title": "卸载转后退",
      "comment": "卸载完成后转后退",
      "elements": [
        {
          "type": "normally_open",
          "operand": "bStateUnload"
        },
        {
          "type": "coil_reset",
          "operand": "bStateUnload"
        },
        {
          "type": "coil_set",
          "operand": "bStateRev"
        }
      ]
    },
    {
      "title": "后退输出",
      "comment": "后退状态驱动电机反转",
      "elements": [
        {
          "type": "normally_open",
          "operand": "bStateRev"
        },
        {
          "type": "coil",
          "operand": "bReverseOut"
        },
        {
          "type": "coil",
          "operand": "bRunning"
        }
      ]
    },
    {
      "title": "后限位转装载",
      "comment": "到后限位后清除后退状态、设置装载状态",
      "elements": [
        {
          "type": "normally_open",
          "operand": "bStateRev"
        },
        {
          "type": "normally_open",
          "operand": "bReverseLimit"
        },
        {
          "type": "coil_reset",
          "operand": "bStateRev"
        },
        {
          "type": "coil_set",
          "operand": "bStateLoad"
        }
      ]
    },
    {
      "title": "装载转继续",
      "comment": "装载完成后继续前进（下一轮）",
      "elements": [
        {
          "type": "normally_open",
          "operand": "bStateLoad"
        },
        {
          "type": "coil_reset",
          "operand": "bStateLoad"
        },
        {
          "type": "coil_set",
          "operand": "bStateFwd"
        }
      ]
    },
    {
      "title": "故障输出",
      "comment": "故障锁存位驱动故障灯",
      "elements": [
        {
          "type": "normally_open",
          "operand": "bFaultLatch"
        },
        {
          "type": "coil",
          "operand": "bFault"
        }
      ]
    }
  ]
}