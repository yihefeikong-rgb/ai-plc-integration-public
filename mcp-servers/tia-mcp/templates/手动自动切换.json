{
  "blockName": "ManualAutoSelector",
  "blockNumber": 680,
  "interface": {
    "inputs": [
      {
        "name": "iModeSelect",
        "type": "Bool",
        "comment": "模式选择（1=自动 0=手动）",
        "address": "%I8.0"
      },
      {
        "name": "iManualStart",
        "type": "Bool",
        "comment": "手动启动",
        "address": "%I8.1"
      },
      {
        "name": "iManualStop",
        "type": "Bool",
        "comment": "手动停止",
        "address": "%I8.2"
      },
      {
        "name": "iAutoStart",
        "type": "Bool",
        "comment": "自动启动信号",
        "address": "%I8.3"
      },
      {
        "name": "iAutoStop",
        "type": "Bool",
        "comment": "自动停止信号",
        "address": "%I8.4"
      },
      {
        "name": "iStopBtn",
        "type": "Bool",
        "comment": "急停（常闭）",
        "address": "%I8.5"
      },
      {
        "name": "iOverload",
        "type": "Bool",
        "comment": "过载（常闭）",
        "address": "%I8.6"
      }
    ],
    "outputs": [
      {
        "name": "oRun",
        "type": "Bool",
        "comment": "设备运行",
        "address": "%Q8.0"
      },
      {
        "name": "oAutoMode",
        "type": "Bool",
        "comment": "自动模式指示",
        "address": "%Q8.1"
      },
      {
        "name": "oManualMode",
        "type": "Bool",
        "comment": "手动模式指示",
        "address": "%Q8.2"
      },
      {
        "name": "oFault",
        "type": "Bool",
        "comment": "故障指示",
        "address": "%Q8.3"
      }
    ],
    "local": [
      {
        "name": "mSafetyOK",
        "type": "Bool",
        "comment": "安全条件"
      },
      {
        "name": "mRunCmd",
        "type": "Bool",
        "comment": "运行指令"
      }
    ]
  },
  "networks": [
    {
      "title": "安全链",
      "comment": "急停和过载正常",
      "elements": [
        {
          "type": "normally_closed",
          "operand": "iStopBtn"
        },
        {
          "type": "normally_closed",
          "operand": "iOverload"
        },
        {
          "type": "coil",
          "operand": "mSafetyOK"
        }
      ]
    },
    {
      "title": "模式指示",
      "comment": "选择开关指示当前模式",
      "elements": [
        {
          "type": "normally_open",
          "operand": "iModeSelect"
        },
        {
          "type": "coil",
          "operand": "oAutoMode"
        }
      ]
    },
    {
      "title": "手动模式指示",
      "comment": "非自动即为手动",
      "elements": [
        {
          "type": "normally_closed",
          "operand": "iModeSelect"
        },
        {
          "type": "coil",
          "operand": "oManualMode"
        }
      ]
    },
    {
      "title": "手动启动",
      "comment": "手动模式下运行",
      "elements": [
        {
          "type": "normally_closed",
          "operand": "iModeSelect"
        },
        {
          "type": "normally_open",
          "operand": "iManualStart"
        },
        {
          "type": "normally_open",
          "operand": "mSafetyOK"
        },
        {
          "type": "coil_set",
          "operand": "mRunCmd"
        }
      ]
    },
    {
      "title": "手动停止",
      "comment": "手动模式停止",
      "elements": [
        {
          "type": "normally_closed",
          "operand": "iModeSelect"
        },
        {
          "type": "normally_open",
          "operand": "iManualStop"
        },
        {
          "type": "coil_reset",
          "operand": "mRunCmd"
        }
      ]
    },
    {
      "title": "自动启动",
      "comment": "自动模式下运行",
      "elements": [
        {
          "type": "normally_open",
          "operand": "iModeSelect"
        },
        {
          "type": "normally_open",
          "operand": "iAutoStart"
        },
        {
          "type": "normally_open",
          "operand": "mSafetyOK"
        },
        {
          "type": "coil_set",
          "operand": "mRunCmd"
        }
      ]
    },
    {
      "title": "自动停止",
      "comment": "自动模式停止",
      "elements": [
        {
          "type": "normally_open",
          "operand": "iModeSelect"
        },
        {
          "type": "normally_open",
          "operand": "iAutoStop"
        },
        {
          "type": "coil_reset",
          "operand": "mRunCmd"
        }
      ]
    },
    {
      "title": "安全链停",
      "comment": "安全条件不满足强制停",
      "elements": [
        {
          "type": "normally_closed",
          "operand": "mSafetyOK"
        },
        {
          "type": "coil_reset",
          "operand": "mRunCmd"
        }
      ]
    },
    {
      "title": "运行输出",
      "comment": "运行指令驱动输出",
      "elements": [
        {
          "type": "normally_open",
          "operand": "mRunCmd"
        },
        {
          "type": "normally_open",
          "operand": "mSafetyOK"
        },
        {
          "type": "coil",
          "operand": "oRun"
        }
      ]
    },
    {
      "title": "故障输出",
      "comment": "安全链断开报警",
      "elements": [
        {
          "type": "normally_closed",
          "operand": "mSafetyOK"
        },
        {
          "type": "coil",
          "operand": "oFault"
        }
      ]
    }
  ]
}